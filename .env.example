# ─────────────────────────────────────────────
# SMTP — отправка email-уведомлений о заявках
# ─────────────────────────────────────────────
# Яндекс 360:  SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_SECURE=true
# Mail.ru бизнес: SMTP_HOST=smtp.mail.ru SMTP_PORT=465  SMTP_SECURE=true
# Свой сервер: укажите хост и порт вашего почтового сервера

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true

# Логин и пароль почтового ящика, от имени которого отправляем
SMTP_USER=online@anrotrip.ru
SMTP_PASS=yourpassword

# Кому приходят заявки (административный директор)
MAIL_TO=online@anrotrip.ru

# От кого в поле «From» (обычно тот же ящик или noreply@)
MAIL_FROM=online@anrotrip.ru

# ─────────────────────────────────────────────
# Telegram — уведомления боту (обязательно настроить)
# ─────────────────────────────────────────────
# 1. Создать бота: написать @BotFather → /newbot → скопировать токен
# 2. Написать боту хоть одно сообщение
# 3. Открыть: https://api.telegram.org/bot<TOKEN>/getUpdates → найти "chat":{"id":...}

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# SEO — верификация сайта (опционально)
# ─────────────────────────────────────────────
# Коды из Google Search Console и Яндекс.Вебмастера.
# После добавления — пересобрать и задеплоить сайт.

PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=
