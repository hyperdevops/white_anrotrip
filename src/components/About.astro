                <div class="absolute inset-0 backface-hidden rotate-y-180 bg-primary text-white rounded-3xl p-4 sm:p-5 flex flex-col justify-center text-center shadow-[0_10px_40px_rgba(0,171,179,0.25)] overflow-hidden">
