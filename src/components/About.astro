  <!-- ══════════════════════════════════════════════
       BOTTOM SHEET (Мобильное всплывающее окно для услуг)
  ══════════════════════════════════════════════ -->
  <div id="services-bottom-sheet" class="fixed inset-0 z-modal hidden opacity-0 transition-opacity duration-300 md:hidden">
    <!-- Backdrop (без блюра) -->
    <div class="absolute inset-0 bg-gray-900/60 transition-opacity duration-300" id="services-sheet-backdrop"></div>
    <!-- Sheet -->
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl p-6 transform translate-y-full transition-transform duration-300 shadow-2xl touch-none" id="services-sheet-content">
      <!-- Drag Handle -->
      <div class="w-full pt-2 pb-4 -mt-4 flex justify-center" id="services-sheet-handle">
        <div class="w-12 h-1.5 bg-gray-200 rounded-full"></div>
      </div>

      <div class="flex items-center gap-4 mb-5">
        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0">
          <span id="sheet-icon" class="inline-flex items-center justify-center text-2xl text-primary"></span>
          <svg
            id="sheet-cruise-icon"
            class="hidden h-14 w-14 text-primary"
            viewBox="0 0 128 128"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d={cruiseShipIconPath} fill="currentColor" />
          </svg>
        </div>
        <h3 id="sheet-title" class="font-montserrat font-bold text-base text-gray-900 leading-tight uppercase"></h3>
      </div>
      <p id="sheet-desc" class="text-gray-600 text-sm leading-relaxed max-h-[50vh] overflow-y-auto custom-scrollbar pr-2 pb-4"></p>
    </div>
  </div>

</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.service-card');
    const sheet = document.getElementById('services-bottom-sheet');
    if (!sheet) return;

    // Переносим в body, чтобы избежать проблем со слоями (stacking context) и перекрыть виджеты
    document.body.appendChild(sheet);

    const sheetContent = document.getElementById('services-sheet-content');
    const sheetBackdrop = document.getElementById('services-sheet-backdrop');
    const sheetIcon = document.getElementById('sheet-icon');
    const sheetCruiseIcon = document.getElementById('sheet-cruise-icon');
    const sheetTitle = document.getElementById('sheet-title');
    const sheetDesc = document.getElementById('sheet-desc');
    const dragHandle = document.getElementById('services-sheet-handle');

    if (!sheetContent || !sheetBackdrop || !sheetIcon || !sheetCruiseIcon || !sheetTitle || !sheetDesc) return;

    let isSheetOpen = false;

    const openSheet = (card: HTMLElement) => {
      if (window.innerWidth >= 768) return;

      const title = card.dataset.title || '';
      const desc = card.dataset.desc || '';
      const iconKind = card.dataset.iconKind || '';

      sheetTitle.textContent = title;
      sheetDesc.textContent = desc;
      sheetIcon.classList.toggle('hidden', iconKind === 'cruise-ship');
      sheetCruiseIcon.classList.toggle('hidden', iconKind !== 'cruise-ship');

      if (iconKind !== 'cruise-ship') {
        const sourceSvg = card.querySelector('.service-card-icon svg');
        sheetIcon.replaceChildren(
          sourceSvg ? sourceSvg.cloneNode(true) : document.createDocumentFragment(),
        );
      }

      sheet.classList.remove('hidden');
      // Trigger reflow
      void sheet.offsetWidth;

      sheet.classList.remove('opacity-0');
      sheetContent.classList.remove('translate-y-full');
      document.body.style.overflow = 'hidden';
      isSheetOpen = true;
    };

    const closeSheet = () => {
      if (!isSheetOpen) return;
      sheet.classList.add('opacity-0');
      sheetContent.style.transform = ''; // Clear custom transform
      sheetContent.classList.add('translate-y-full');
      document.body.style.overflow = '';
      isSheetOpen = false;

      setTimeout(() => {
        if (!isSheetOpen) sheet.classList.add('hidden');
      }, 300);
    };

    // Открытие по клику на карточки
    cards.forEach(card => {
      card.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          openSheet(card as HTMLElement);
        }
      });
    });

    // Закрытие по клику на фон
    sheetBackdrop.addEventListener('click', closeSheet);

    // --- Логика смахивания (Swipe to close) ---
    let startY = 0;
    let currentY = 0;
    let isDragging = false;

    const onTouchStart = (e: TouchEvent) => {
      // Разрешаем скролл внутри текста, если мы не тянем за верхнюю ручку
      const scrollable = sheetContent.querySelector('.overflow-y-auto');
      const isHandle = dragHandle?.contains(e.target as Node);

      if (!isHandle && scrollable && scrollable.contains(e.target as Node) && scrollable.scrollTop > 0) {
        return; // Пользователь скроллит текст
      }

      startY = e.touches[0].clientY;
      isDragging = true;
      sheetContent.style.transition = 'none'; // Отключаем анимацию для следования за пальцем
    };

    const onTouchMove = (e: TouchEvent) => {
      if (!isDragging) return;
      currentY = e.touches[0].clientY;
      const deltaY = currentY - startY;

      // Тянем только вниз
      if (deltaY > 0) {
        e.preventDefault(); // Предотвращаем скролл страницы
        sheetContent.style.transform = `translateY(${deltaY}px)`;
      }
    };

    const onTouchEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      sheetContent.style.transition = ''; // Возвращаем CSS-анимацию

      const deltaY = currentY - startY;
      if (deltaY > 100) {
        // Если смахнули достаточно сильно — закрываем
        closeSheet();
      } else {
        // Иначе возвращаем на место
        sheetContent.style.transform = 'translateY(0)';
        setTimeout(() => {
          if (isSheetOpen) sheetContent.style.transform = '';
        }, 300);
      }
      currentY = 0;
    };

    sheetContent.addEventListener('touchstart', onTouchStart, { passive: false });
    sheetContent.addEventListener('touchmove', onTouchMove, { passive: false });
    sheetContent.addEventListener('touchend', onTouchEnd);
  });
</script>
