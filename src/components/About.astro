---
// src/components/About.astro
import { siteCorp } from '../lib/site-urls';
import TrustBadges from './TrustBadges.astro';

/* Плашки услуг: иконки — Font Awesome Solid (см. global.css) */
const services = [
  {
    title: 'АВИА и Ж/Д БИЛЕТЫ',
    iconClass: 'fa-solid fa-ticket-simple',
  },
  {
    title: 'VIP-залы',
    iconClass: 'fa-solid fa-crown',
  },
  {
    title: 'VIP-сопровождение в аэропортах',
    iconClass: 'fa-solid fa-person-walking-luggage',
  },
  {
    title: 'ТУРЫ',
    iconClass: 'fa-solid fa-globe',
  },
  {
    title: 'КРУИЗЫ',
    iconClass: 'fa-solid fa-sailboat',
  },
  {
    title: 'ОТЕЛИ',
    iconClass: 'fa-solid fa-hotel',
  },
  {
    title: 'ВИЗОВАЯ ПОДДЕРЖКА',
    iconClass: 'fa-solid fa-passport',
  },
  {
    title: 'ТРАНСФЕРЫ',
    iconClass: 'fa-solid fa-van-shuttle',
  },
  {
    title: 'СТРАХОВАНИЕ',
    iconClass: 'fa-solid fa-heart',
  },
];

/* Направления работы — иконки Font Awesome Solid */
const directions = [
  {
    num: '01',
    title: 'Корпоративное обслуживание',
    desc: 'ANRO TRIP полностью возьмёт на себя организацию командировок вашей компании. Заключаем договор на индивидуальных условиях. Предоставляем отчётные документы через ЭДО.',
    iconClass: 'fa-solid fa-briefcase',
    accent: 'bg-primary',
  },
  {
    num: '02',
    title: 'Персональное сопровождение путешествий',
    desc: 'За Вами закрепляется личный ассистент, который выслушает Ваши пожелания, подберёт маршрут и будет на связи 24/7 — от первого звонка до возвращения домой. Отели, билеты, трансферы, страховка и визовая поддержка — все эти услуги мы делаем для Вас.',
    iconClass: 'fa-solid fa-plane-departure',
    accent: 'bg-secondary',
  },
  {
    num: '03',
    title: 'Агентское обслуживание',
    desc: 'Работаем с частными клиентами напрямую: туры по всему миру, круизы, авиабилеты и отели по агентским тарифам. Подберём оптимальный вариант под Ваш бюджет и предпочтения, оформим все документы и обеспечим поддержку на протяжении всей поездки.',
    iconClass: 'fa-solid fa-handshake',
    accent: 'bg-cta',
  },
];

export interface Props {
  class?: string;
}
const { class: classes = '' } = Astro.props;
---

<section id="about" class={`relative overflow-hidden bg-white ${classes}`}>

  <!-- ══════════════════════════════════════════════
       БЛОК 1 — HERO-ЗАЯВЛЕНИЕ (асимметричный)
  ══════════════════════════════════════════════ -->
  <div class="relative pt-12 pb-20 md:pt-20 md:pb-24 bg-white overflow-hidden">
    <!-- Декор: большая буква фоном -->
    <!-- <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[25rem] font-montserrat font-black text-primary/[0.04] leading-none select-none pointer-events-none -mr-16 hidden lg:block">A</div> -->

          <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[16rem] md:text-[22rem] font-montserrat font-black text-primary/[0.04] leading-none select-none pointer-events-none -mr-16 hidden lg:block"
        >
          A
        </div>
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-20 items-center">

        <!-- Левая часть: текст -->
        <div class="reveal-hidden">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/8 border border-primary/15 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-primary md:animate-pulse"></span>
            <span class="text-xs font-semibold text-primary uppercase tracking-widest font-montserrat">О компании</span>
          </div>

          <h2 class="font-montserrat font-extrabold text-gray-900 uppercase tracking-tight mb-6 leading-[0.95]" style="font-size: clamp(2rem, 1.5rem + 3vw, 4rem);">
            Почему<br />
            выбирают<br />
            <span class="text-primary">ANRO TRIP</span>
          </h2>

          <p class="text-gray-500 text-lg leading-relaxed max-w-lg mb-8">
            Консьерж-сервис по организации путешествий и командировок
            по всему миру. <strong class="text-gray-800 font-semibold">19 лет</strong> безупречной репутации
            и <br class="md:hidden" /><strong class="text-gray-800 font-semibold">17 000+</strong> довольных клиентов.
          </p>

          <!-- Быстрые теги (один ряд, три плашки; третья — заглушка под текст от заказчика) -->
          <div class="flex flex-nowrap gap-2 overflow-x-auto pb-0.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {['Личный ассистент', '24/7 поддержка', '—'].map((tag, i) => (
              <span
                class="shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors cursor-default whitespace-nowrap"
                title={i === 2 ? 'Замените на финальный текст по согласованию с заказчиком' : undefined}
              >
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Правая часть: Trust Badges -->
        <div class="lg:min-w-[420px] reveal-hidden">
          <TrustBadges />
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 2 — УСЛУГИ (пилюли); якорь для бейджа в Hero и меню
  ══════════════════════════════════════════════ -->
  <div class="py-10 bg-gray-50 border-y border-gray-100 overflow-hidden reveal-hidden">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <p
        id="services"
        class="text-sm sm:text-base font-semibold text-gray-400 uppercase tracking-widest font-montserrat mb-5 md:mb-6 text-center scroll-mt-[calc(var(--site-header-h,5rem)+100px)]"
      >
        Наши услуги
      </p>
      <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
        {services.map((item) => (
          <div class="about-services-pill flex items-center gap-2 sm:gap-2.5 px-4 py-2.5 sm:px-5 sm:py-3 rounded-full bg-white border border-gray-200 cursor-default group">
            <i
              class:list={[
                ...item.iconClass.split(/\s+/).filter(Boolean),
                'text-primary shrink-0 text-base leading-none',
              ]}
              aria-hidden="true"
            />
            <span class="text-xs sm:text-sm font-semibold tracking-wide text-gray-700 group-hover:text-gray-900 leading-none whitespace-nowrap">{item.title}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 3 — BENTO ПРЕИМУЩЕСТВА
  ══════════════════════════════════════════════ -->
  <div class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" data-reveal-stagger>

        <!-- Карточка 1: большая — «Быстро развиваемся» -->
        <div class="reveal-hidden md:col-span-2 relative overflow-hidden rounded-3xl bg-linear-to-br from-primary to-secondary p-8 md:p-10 text-white min-h-[240px] flex flex-col justify-between group">
          <div class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-white/10 pointer-events-none"></div>
          <div class="absolute -right-4 -bottom-8 w-32 h-32 rounded-full bg-white/5 pointer-events-none"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center mb-6 group-hover:bg-white/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="font-montserrat font-bold text-2xl mb-3 leading-tight">Быстро развиваемся</h3>
            <p class="text-white/80 leading-relaxed">Входим в <strong class="text-white">ТОП-10 компаний России</strong> по результатам 2026 года. Ежегодно увеличиваем объём и расширяем географию.</p>
          </div>
          <div class="flex items-center gap-2 mt-6 text-white/60 text-sm font-medium">
            <span class="w-8 h-px bg-white/40"></span>
            Топ-10 России 2026
          </div>
        </div>

        <!-- Карточка 2: маленькая — «Всегда на связи» -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-gray-900 p-8 text-white min-h-[240px] flex flex-col justify-between group">
          <div class="absolute inset-0 bg-linear-to-br from-gray-900 to-gray-800 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary/30 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-montserrat font-bold text-xl mb-3">Всегда на связи</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Круглосуточная поддержка клиентов — 24/7, без выходных и праздников.</p>
          </div>
          <div class="relative z-10 mt-6">
            <span class="inline-block px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-bold">24 / 7</span>
          </div>
        </div>

        <!-- Карточка 3: широкая — «Собственная авиакасса» -->
        <div class="about-avia-card reveal-hidden md:col-span-3 relative overflow-hidden rounded-3xl bg-gray-50 border border-gray-100 p-8 md:p-10 min-h-[180px] flex flex-col md:flex-row md:items-center gap-8 group transition-all duration-normal max-sm:transition-none">
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors duration-normal">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="font-montserrat font-bold text-xl text-gray-900 mb-2">Собственная авиакасса</h3>
            <p class="text-gray-500 leading-relaxed max-w-2xl">Бронируем любые направления и быстро осуществляем обмен и возврат в собственных <strong class="text-gray-700">GDS-пультах</strong>. Прямой доступ к тарифам без посредников.</p>
          </div>
          <div class="shrink-0 hidden md:flex items-center gap-3">
            <span class="text-5xl font-montserrat font-black text-gray-100">GDS</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 4 — НАПРАВЛЕНИЯ РАБОТЫ (нумерованный список)
  ══════════════════════════════════════════════ -->
  <div
    id="directions"
    class="py-16 md:py-24 bg-gray-50 border-t border-gray-100 scroll-mt-[calc(var(--site-header-h,5rem)+var(--scroll-offset,22px))]"
  >
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">

      <!-- Заголовок — асимметричный; декор: крупный самолёт как буква «A» в hero (primary / 4%) -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8 md:mb-16 reveal-hidden">
        <div class="flex-1 min-w-0">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-secondary/8 border border-secondary/15 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary md:animate-pulse"></span>
            <span class="text-xs font-semibold text-secondary uppercase tracking-widest font-montserrat">Направления</span>
          </div>
          <h2 class="font-montserrat font-extrabold text-gray-900 uppercase tracking-tight leading-none" style="font-size: clamp(2rem, 1.5rem + 3vw, 4rem);">
            Направления<br />работы<br />
            <span class="text-primary">ANRO TRIP</span>
          </h2>
        </div>
        <div
          class="hidden md:flex shrink-0 justify-end overflow-visible pointer-events-none select-none md:-translate-y-8"
          aria-hidden="true"
        >
          <i
            class="fa-solid fa-plane block leading-none text-primary/[0.04] -rotate-18 text-[10rem] sm:text-[12rem] md:text-[16rem] lg:text-[22rem] -my-2 md:-my-4 md:-mr-16"
          ></i>
        </div>
      </div>

      <!-- Список направлений -->
      <div class="space-y-0">
        {directions.map((item, i) => (
          <div
            class:list={[
              'reveal-hidden group flex items-start gap-6 md:gap-10 border-b border-gray-200 last:border-0 hover:bg-white hover:px-6 hover:-mx-6 hover:rounded-2xl transition-all duration-normal',
              i === 0 ? 'pt-4 pb-8 md:py-8' : 'py-8',
            ]}
          >

            <!-- Номер: фиксированная ширина + tabular-nums для выравнивания (web-standards) -->
            <div class="shrink-0 w-20 md:w-28 font-montserrat font-black text-5xl md:text-7xl text-gray-100 group-hover:text-primary/20 transition-colors leading-none select-none pt-1 tabular-nums self-start whitespace-nowrap">
              {item.num}
            </div>

            <!-- Контент -->
            <div class="flex-1 flex flex-col md:flex-row md:items-start gap-4 md:gap-8 min-w-0 self-start">
              <!-- Иконка -->
              <div class={`shrink-0 w-12 h-12 rounded-2xl ${item.accent} flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform duration-normal`}>
                <i
                  class:list={[
                    ...item.iconClass.split(/\s+/).filter(Boolean),
                    'text-white text-xl sm:text-2xl leading-none',
                  ]}
                  aria-hidden="true"
                />
              </div>

              <!-- Текст -->
              <div class="flex-1">
                <h3 class="font-montserrat font-bold text-xl text-gray-900 mb-2 group-hover:text-primary transition-colors">
                  {item.title}
                </h3>
                <p class="text-gray-500 leading-relaxed text-sm max-w-2xl">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 5 — CTA (тёмная полоса), якорь «Наши услуги» в хедере
  ══════════════════════════════════════════════ -->
  <div
    id="business"
    class="relative overflow-hidden bg-gray-900 py-14 md:py-20 scroll-mt-[calc(var(--site-header-h,5rem)+30px)]"
  >
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-none md:blur-3xl pointer-events-none -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-secondary/10 rounded-full blur-none md:blur-3xl pointer-events-none translate-y-1/2"></div>

    <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">

        <div class="text-center lg:text-left">
          <p class="text-gray-400 text-sm uppercase tracking-widest font-montserrat mb-3">Начните прямо сейчас</p>
          <h3 class="font-montserrat font-extrabold text-white text-2xl md:text-3xl leading-tight">
            Свяжитесь с нами<br />
            <span class="text-primary">и оцените сервис ANRO TRIP</span>
          </h3>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 shrink-0">
          <a
            href="https://wa.me/79220267059"
            class="about-cta-btn inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full bg-primary text-white font-bold font-montserrat text-sm uppercase tracking-wider shadow-[0_4px_24px_rgba(0,171,179,0.4)] hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/30 btn-ripple focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 cursor-pointer"
          >
            Персональный ассистент
            <i class="fa-solid fa-arrow-right text-sm leading-none shrink-0" aria-hidden="true"></i>
          </a>
          <a
            href={siteCorp()}
            class="about-cta-btn inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full border border-primary/35 text-white font-semibold font-montserrat text-sm uppercase tracking-wider shadow-[0_4px_24px_rgba(0,171,179,0.4)] hover:bg-primary/10 active:bg-primary/30 active:border-primary/50 transition-colors duration-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 btn-ripple cursor-pointer"
          >
            Коммерческое Предложение
          </a>
        </div>
      </div>
    </div>
  </div>

</section>
