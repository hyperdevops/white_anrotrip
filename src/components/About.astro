              <!-- Контейнер для 3D-переворота (только десктоп) -->
              <div class="relative w-full h-full transition-transform duration-700 preserve-3d md:group-hover:rotate-y-180">

                <!-- Лицевая сторона (Иконка + Заголовок) -->
                <div class="absolute inset-0 backface-hidden bg-white border border-primary/20 rounded-3xl p-4 sm:p-6 flex flex-col items-center justify-center text-center shadow-[0_8px_24px_-4px_rgb(0_171_179/0.15)] group-hover:border-primary/35 group-hover:shadow-[0_12px_32px_-6px_rgb(0_171_179/0.28)] transition-[border-color,box-shadow] duration-normal">
                  <div class="service-card-icon w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-primary/5 flex items-center justify-center mb-3 sm:mb-4">
                    {item.customIcon === 'cruise-ship' ? (
                      <svg
                        class="h-14 w-14 text-primary"
                        viewBox="0 0 128 128"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                      >
                        <path d={cruiseShipIconPath} fill="currentColor" />
                      </svg>
                    ) : (
                      <FaIcon name={item.icon} iconClass="text-2xl sm:text-3xl text-primary" />
                    )}
                  </div>
                  <h3 class="font-montserrat font-bold text-xs sm:text-sm text-gray-900 leading-tight uppercase">{item.title}</h3>
                </div>

                <!-- Обратная сторона (Текст) -->
                <div class="absolute inset-0 backface-hidden rotate-y-180 bg-primary text-white rounded-3xl p-4 sm:p-5 flex flex-col justify-center text-center shadow-[0_10px_40px_rgba(0,171,179,0.25)] overflow-hidden">
                  <h4 class="font-montserrat font-bold mb-2 text-xs sm:text-sm uppercase tracking-wider opacity-90">{item.title}</h4>
                  <div class="overflow-y-auto custom-scrollbar pr-1 text-[0.7rem] sm:text-xs leading-relaxed opacity-95">
                    {item.desc}
                  </div>
                </div>

              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
