---
// src/components/About.astro
import {
  maxIconPath,
  socialLogoTransform0,
  socialLogoTransform80,
  telegramIconPath,
} from '../lib/social-icons';
import TrustBadges from './TrustBadges.astro';

/* Плашки услуг: иконки — Font Awesome Solid (см. global.css) */
const services = [
  {
    title: 'АВИА и Ж/Д БИЛЕТЫ',
    iconClass: 'fa-solid fa-plane-departure',
    desc: 'Подбор и бронирование авиа и ж/д билетов по всему миру. Работаем с регулярными и чартерными рейсами, подбираем оптимальные маршруты, тарифы, стыковки. Оперативное оформление и поддержка при изменениях. Обмен и возврат билетов по сообщению в вашем личном чате. Помогаем с апгрейдами, регистрируем на рейс, помогаем с увеличением багажа, провозом нестандартного багажа. Оформляем перелёты для детей с сопровождением от авиакомпании. Оформляем для вас перелёты с четвероногими друзьями. Сопровождаем группы.',
  },
  {
    title: 'VIP-залы',
    iconClass: 'fa-solid fa-building',
    desc: 'Заранее забронируем для вас комфортное ожидание рейса — доступ в бизнес и VIP-залы аэропортов по всему миру',
  },
  {
    title: 'VIP-сопровождение в аэропортах',
    iconClass: 'fa-solid fa-suitcase-rolling',
    desc: 'Персональная помощь на всех этапах путешествия: ускоренное прохождение регистрации, контроля и паспортных процедур, встреча и сопровождение в аэропорту, помощь с багажом и трансферами',
  },
  {
    title: 'ТУРЫ',
    iconClass: 'fa-solid fa-globe',
    desc: 'Подбор и бронирование индивидуальных, групповых пакетных туров под любые запросы: пляжный отдых, экскурсионные маршруты, семейные, индивидуальные путешествия и mice-туризм. Работаем с ведущими туроператорами и проверенными отелями',
  },
  {
    title: 'КРУИЗЫ',
    iconClass: 'fa-solid fa-sailboat',
    desc: 'Организация морских и речных круизов по России и миру. Подбор маршрута, лайнера и каюты, помощь с оформлением документов и сопровождение до начала путешествия',
  },
  {
    title: 'ОТЕЛИ',
    iconClass: 'fa-solid fa-hotel',
    desc: 'Бронирование отелей любого уровня. Индивидуальный подбор по бюджету, локации и предпочтениям, выгодные условия и специальные тарифы',
  },
  {
    title: 'ВИЗОВАЯ ПОДДЕРЖКА',
    iconClass: 'fa-solid fa-passport',
    desc: 'Консультации и сопровождение при оформлении туристических виз и виз по приглашению. Подготовка пакета документов, заполнение анкет, запись в визовые центры и сопровождение на всех этапах подачи',
  },
  {
    title: 'ТРАНСФЕРЫ',
    iconClass: 'fa-solid fa-van-shuttle',
    desc: 'Организация индивидуальных и групповых трансферов: аэропорт — отель — аэропорт, а также поездки по городу и между курортами. Комфортные автомобили и проверенные перевозчики',
  },
  {
    title: 'СТРАХОВАНИЕ',
    iconClass: 'fa-solid fa-shield-halved',
    desc: 'Оформление туристической страховки для поездок за границу и по России. Подбор оптимального покрытия: медицинские расходы, багаж, отмена поездки и дополнительные риски. Страхование от невыезда',
  },
];

/* Направления работы — иконки Font Awesome Solid */
const directions = [
  {
    num: '01',
    title: 'Корпоративное обслуживание',
    desc: 'ANRO TRIP полностью берёт на себя организацию командировок вашей компании. Заключаем договор на индивидуальных условиях. Предоставляем отчётные документы через ЭДО или любым удобным для вас способом.',
    iconClass: 'fa-solid fa-briefcase',
    accent: 'bg-primary',
  },
  {
    num: '02',
    title: 'Персональное сопровождение перелётов и путешествий',
    desc: 'За Вами закрепляется личный ассистент, который проконсультирует, подберёт комфортный маршрут, отель, тур, поможет с подготовкой визовых документов и будет на связи 24/7 — от обращения до возвращения домой.',
    iconClass: 'fa-solid fa-plane-departure',
    accent: 'bg-secondary',
  },
  {
    num: '03',
    title: 'Агентское обслуживание',
    desc: 'Сотрудничаем с туристическими агентствами по бронированию авиа и ж/д билетов. Предлагаем доступ к билетам всех российских и международных авиакомпаний и помощь на всех этапах бронирования. Сопровождаем заявки до завершения поездки ваших клиентов.',
    iconClass: 'fa-solid fa-handshake',
    accent: 'bg-gray-400',
  },
];

export interface Props {
  class?: string;
}
const { class: classes = '' } = Astro.props;
---

<section id="about" class={`relative overflow-hidden bg-white ${classes}`}>

  <!-- ══════════════════════════════════════════════
       БЛОК 1 — HERO-ЗАЯВЛЕНИЕ (асимметричный)
  ══════════════════════════════════════════════ -->
  <div class="relative py-[50px] bg-white overflow-hidden">
    <!-- Декор: большая буква фоном -->
    <div class="absolute right-0 top-[calc(50%-10px)] -translate-y-1/2 text-[16rem] md:text-[22rem] font-montserrat font-black text-primary/[0.04] leading-none select-none pointer-events-none -mr-16 hidden lg:block">
      A
    </div>
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-20 items-center">

        <!-- Левая часть: текст -->
        <div class="reveal-hidden">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/8 border border-primary/15 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-primary md:animate-pulse"></span>
            <span class="text-xs font-semibold text-primary uppercase tracking-widest font-montserrat">О нас</span>
          </div>

          <h2 class="section-heading-plus font-montserrat font-extrabold text-gray-900 uppercase tracking-tight mb-7">
            Почему<br />
            выбирают<br />
            <span class="text-primary">ANRO TRIP?</span>
          </h2>
             <ul class="mb-8 max-w-lg list-none space-y-3 text-base leading-relaxed text-gray-600">
               <li class="flex gap-3">
                 <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                 <span>
                   Наш <strong class="font-bold text-gray-900">генеральный директор Анна&nbsp;Рожкова</strong> работает в&nbsp;авиабизнесе и&nbsp;туризме с&nbsp;2007&nbsp;года.
                 </span>
               </li>
               <li class="flex gap-3">
                 <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                 <span>
                   Благодаря многолетнему опыту и&nbsp;надёжной репутации <strong class="font-bold text-gray-900">в&nbsp;2019&nbsp;году была основана</strong> <span class="text-primary">туристическая компания ANRO&nbsp;TRIP</span>, а&nbsp;в&nbsp;2020&nbsp;году зарегистрирован <strong class="font-bold text-gray-900">собственный товарный знак <span class="text-primary">ANRO®</span></strong>.
                 </span>
               </li>
               <li class="flex gap-3">
                 <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                 <span>
                   С&nbsp;2020&nbsp;года ANRO&nbsp;TRIP имеет <strong class="font-bold text-gray-900">аккредитацию туроператора по&nbsp;внутреннему туризму</strong>.
                 </span>
               </li>
               <li class="flex gap-3">
                 <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                 <span>
                   С&nbsp;самого основания компания работает в&nbsp;собственном офисе, а&nbsp;с&nbsp;2025&nbsp;года является плательщиком НДС.
                 </span>
               </li>
               <li class="flex gap-3">
                 <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                 <span>
                   Сегодня в&nbsp;команде ANRO&nbsp;TRIP работает <strong class="font-bold text-gray-900">27&nbsp;профессионалов</strong>, объединённых общей целью&nbsp;—
                   <span class="mt-2 block font-bold uppercase tracking-wide text-primary">Создавать туристический сервис, доступный каждому!</span>
                 </span>
               </li>
             </ul>

          <!-- Быстрые теги — ценности компании -->
          <div class="flex w-full max-w-lg gap-2">
            {['Экспертность', 'Надежность', 'Оперативность'].map((tag) => (
              <span class="flex-1 rounded-full px-3 py-1 text-center text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-primary/10 hover:text-primary transition-colors cursor-default">{tag}</span>
            ))}
          </div>
        </div>

        <!-- Правая часть: Trust Badges -->
        <div class="lg:min-w-[640px] reveal-hidden flex flex-col gap-4">
          <TrustBadges />
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 3 — СЕТКА ПРЕИМУЩЕСТВ
  ══════════════════════════════════════════════ -->
  <div class="py-[50px] bg-primary/4 border-t border-primary/5">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" data-reveal-stagger>

        <!-- 1. Все услуги -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-linear-to-br from-primary to-secondary p-6 sm:p-8 text-white flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/30 transition-shadow duration-normal">
          <div class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-white/10 pointer-events-none"></div>
          <div class="absolute -right-4 -bottom-8 w-32 h-32 rounded-full bg-white/5 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-white/30 transition-colors">
              <i class="fa-solid fa-layer-group text-xl text-white"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 leading-tight">Все услуги в одной компании</h3>
            <p class="text-white/80 leading-relaxed text-sm">Авиа и ж/д билеты, туры, визы, отели, круизы, трансферы, экскурсии, страхование и полное сопровождение в поездке.</p>
          </div>
        </div>

        <!-- 2. Аккредитации -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-certificate text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Аккредитации</h3>
            <p class="text-gray-500 leading-relaxed text-sm">Имеем прямые аккредитации по продаже авиабилетов — IATA, ТКП и Аэрофлот для полного контроля оформления авиабилетов.</p>
          </div>
        </div>

        <!-- 3. Работаем для всех -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-users text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Работаем для всех</h3>
            <p class="text-gray-500 leading-relaxed text-sm">Сотрудничаем с частными и корпоративными клиентами, а также туристическими агентствами.</p>
          </div>
        </div>

        <!-- 4. Работаем по всему миру -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-earth-americas text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Работаем по всему миру</h3>
            <p class="text-gray-500 leading-relaxed text-sm">Оформляем любые туристические услуги дистанционно для клиентов из любых регионов и стран.</p>
          </div>
        </div>

        <!-- 5. Сильная команда -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-people-group text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Сильная команда</h3>
            <p class="text-gray-500 leading-relaxed text-sm">С вами работают профессионалы с большим опытом, вниманием к деталям и любовью к своему делу.</p>
          </div>
        </div>

        <!-- 6. Быстро растём -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-arrow-trend-up text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Быстро растём и развиваемся</h3>
            <p class="text-gray-500 leading-relaxed text-sm">За 7 лет стали лидером продаж у ведущих туроператоров и мировых отелей.</p>
          </div>
        </div>

        <!-- 7. Персональный сервис -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-gray-900 border border-primary/25 p-6 sm:p-8 text-white flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/30 transition-shadow duration-normal">
          <div class="absolute inset-0 bg-linear-to-br from-gray-900 to-gray-800 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/20 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/30 transition-colors">
              <i class="fa-solid fa-headset text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 leading-tight">Персональный сервис</h3>
            <p class="text-gray-400 leading-relaxed text-sm">После обращения создаём личный чат с менеджером и круглосуточной поддержкой 24/7.</p>
          </div>
        </div>

        <!-- 8. Удобная оплата -->
        <div class="reveal-hidden relative overflow-hidden rounded-3xl bg-white border border-primary/15 p-6 sm:p-8 flex flex-col justify-between group hover:shadow-lg hover:shadow-primary/20 transition-shadow duration-normal">
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5 sm:mb-6 group-hover:bg-primary/20 transition-colors">
              <i class="fa-solid fa-credit-card text-xl text-primary"></i>
            </div>
            <h3 class="font-montserrat font-bold text-lg mb-2 sm:mb-3 text-gray-900 leading-tight">Удобная оплата</h3>
            <p class="text-gray-500 leading-relaxed text-sm">Принимаем оплату в рублях из любой точки мира быстро и удобно.</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 4 — НАПРАВЛЕНИЯ РАБОТЫ (нумерованный список)
  ══════════════════════════════════════════════ -->
  <div
    id="directions"
    class="relative pt-10 md:pt-12 pb-[50px] bg-white overflow-hidden md:overflow-visible scroll-mt-[calc(var(--site-header-h,5rem)-30px)]"
  >
    <i
      class="fa-solid fa-plane hidden md:block absolute right-4 lg:right-10 top-4 md:top-8 -translate-y-12 lg:-translate-y-14 leading-none text-primary/[0.04] -rotate-24 text-[16rem] lg:text-[20rem] pointer-events-none select-none"
      aria-hidden="true"
    ></i>
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">

      <!-- Заголовок; самолёт на уровне секции — к краю страницы (как «A» в hero) -->
      <div class="relative mb-10 md:mb-12 reveal-hidden">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/8 border border-primary/15 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-primary md:animate-pulse"></span>
            <span class="text-xs font-semibold text-primary uppercase tracking-widest font-montserrat">Направления</span>
          </div>
          <h2 class="section-heading-plus font-montserrat font-extrabold text-gray-900 uppercase tracking-tight">
            Направления<br />
            работы <span class="text-primary">ANRO TRIP</span>
          </h2>
        </div>
      </div>

      <!-- Список направлений -->
      <div class="space-y-0">
        {directions.map((item, i) => (
          <div
            class:list={[
              'reveal-hidden group flex items-start gap-8 md:gap-10 border-b border-gray-100 last:border-0 hover:border-b-primary/15 [&:has(+:hover)]:border-b-primary/15 hover:bg-primary/4 hover:px-6 hover:-mx-6 hover:rounded-2xl transition-all duration-normal',
              i === 0 ? 'pt-0 pb-5 md:py-5' : 'py-5',
            ]}
          >

            <!-- Номер: фиксированная ширина, моноширинные цифры -->
            <div class="shrink-0 w-14 md:w-17 font-montserrat font-black text-[2.5rem] md:text-[3.33rem] text-gray-100 group-hover:text-primary/20 transition-colors leading-none select-none pt-1 tabular-nums self-start whitespace-nowrap">
              {item.num}
            </div>

            <!-- Контент -->
            <div class="flex-1 flex flex-col md:flex-row md:items-start gap-4 md:gap-8 min-w-0 self-start">
              <!-- Иконка -->
              <div class={`shrink-0 w-11 h-11 rounded-xl ${item.accent} flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform duration-normal`}>
                <i
                  class:list={[
                    ...item.iconClass.split(/\s+/).filter(Boolean),
                    'text-white text-xl sm:text-[1.33rem] leading-none',
                  ]}
                  aria-hidden="true"
                />
              </div>

              <!-- Текст -->
              <div class="flex-1">
                <h3 class="font-montserrat font-bold text-xl text-gray-900 mb-2 group-hover:text-primary transition-colors">
                  {item.title}
                </h3>
                <p class="text-gray-500 leading-relaxed text-sm max-w-2xl">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       БЛОК 2 — УСЛУГИ (пилюли); якорь для бейджа в Hero и меню
  ══════════════════════════════════════════════ -->
  <div class="relative z-20 py-[50px] bg-primary/4 border-t border-primary/5 reveal-hidden">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="mb-4 md:mb-8 reveal-hidden">
        <div
          id="services"
          class="scroll-mt-[calc(var(--site-header-h,5rem)+20px)]"
        >
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/8 border border-primary/15 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-primary md:animate-pulse"></span>
            <span class="text-xs font-semibold text-primary uppercase tracking-widest font-montserrat">Наши услуги</span>
          </div>
          <h2
            class="section-heading-plus font-montserrat font-extrabold text-gray-900 uppercase tracking-tight"
          >
            Наши <span class="text-primary">услуги</span>
          </h2>
        </div>
      </div>

      <p class="reveal-hidden mb-4 text-sm font-bold text-gray-500 md:hidden">
        Нажмите на карточку, чтобы прочитать подробности
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5" data-reveal-stagger>
