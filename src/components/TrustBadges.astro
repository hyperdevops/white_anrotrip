---
// src/components/TrustBadges.astro
// Бейджи доверия (РТО, ТОП-10, Опыт, Клиенты, Корпоративы)

import { iataIconPath, iataIconViewBoxEmblem } from '../lib/iata-icon';
import { siteHome } from '../lib/site-urls';

const badges = [
  {
    icon: 'shield',
    label: 'Туроператор',
    value: 'РТО 022708',
    colorClass: 'text-primary',
    bgClass: 'bg-primary/10',
    href: 'https://www.economy.gov.ru/material/directions/turizm/reestry_turizm/edinyy_federalnyy_reestr_turoperatorov/',
    external: true,
  },
  {
    icon: 'shield-check',
    label: 'Турагент',
    value: 'РТА 0024615',
    colorClass: 'text-cyan-600',
    bgClass: 'bg-cyan-600/10',
    href: 'https://ev.economy.gov.ru/lk_exp/registry/',
    external: true,
  },
  {
    icon: 'iata',
    label: 'Аккредитация',
    value: 'IATA',
    colorClass: 'text-secondary',
    bgClass: 'bg-secondary/10',
    href: 'https://www.iata.org/',
    external: true,
  },
  {
    icon: 'tkp',
    label: 'Аккредитация',
    value: 'ТКП',
    colorClass: 'text-secondary',
    bgClass: 'bg-secondary/10',
    href: 'https://www.tch.ru/',
    external: true,
  },
  {
    icon: 'users',
    label: 'Клиентов',
    value: '17 000+',
    colorClass: 'text-primary',
    bgClass: 'bg-primary/10',
    href: `${siteHome()}#partners`,
  },
  {
    icon: 'building',
    label: 'Корпоративы',
    value: '800+ компаний',
    colorClass: 'text-secondary',
    bgClass: 'bg-secondary/10',
    href: `${siteHome()}#business`,
  },
];
---

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3 gap-3 sm:gap-4 md:gap-6 w-full py-6 sm:py-8">
  {badges.map((badge) => (
    <a
      href={badge.href}
      target={badge.external ? '_blank' : undefined}
      rel={badge.external ? 'noopener noreferrer' : undefined}
      class:list={[
        'trust-badges-card glass-panel-interactive px-3 py-3 sm:px-5 sm:py-4 rounded-2xl flex flex-col sm:flex-row items-center gap-2 sm:gap-3 group cursor-pointer min-h-0 no-underline text-inherit hover:no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 w-full min-w-0 text-center sm:text-left overflow-visible',
        'max-sm:contain-[layout] max-sm:transition-shadow max-sm:duration-fast max-sm:hover:translate-y-0',
        'sm:transition-all sm:hover:shadow-lg',
      ]}
    >
      <!-- Иконка в круге: на мобильном без scale при тапе — меньше композитинга -->
      <div class={`w-10 h-10 sm:w-12 sm:h-12 rounded-full ${badge.bgClass} flex items-center justify-center shrink-0 max-sm:transition-none max-sm:group-hover:scale-100 sm:transition-transform sm:group-hover:scale-110`}>
        {badge.icon === 'shield' && (
          <svg class={`w-5 h-5 sm:w-6 sm:h-6 ${badge.colorClass}`} fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 17.93c-3.95-1.19-7-5.19-7-9.93V6.3l7-3.11v15.74z"/>
          </svg>
        )}
        {badge.icon === 'shield-check' && (
          <svg class={`w-5 h-5 sm:w-6 sm:h-6 ${badge.colorClass}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        )}
        {badge.icon === 'iata' && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox={iataIconViewBoxEmblem}
            preserveAspectRatio="xMidYMid meet"
            class={`mx-auto block size-7 sm:size-8 shrink-0 -translate-y-[4px] sm:-translate-y-[6px] ${badge.colorClass}`}
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={iataIconPath} />
          </svg>
        )}
        {badge.icon === 'tkp' && (
          <span
            class:list={[
              'mx-auto block h-3 w-7 sm:h-3.5 sm:w-8 shrink-0 bg-secondary',
              'mask-[url(/logos/tkp.png)] mask-center mask-no-repeat [mask-size:contain]',
              '[-webkit-mask-image:url(/logos/tkp.png)] [-webkit-mask-position:center] [-webkit-mask-repeat:no-repeat] [-webkit-mask-size:contain]',
            ]}
            aria-hidden="true"
          />
        )}
        {badge.icon === 'users' && (
          <svg class={`w-5 h-5 sm:w-6 sm:h-6 ${badge.colorClass}`} fill="currentColor" viewBox="0 0 24 24">
            <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
          </svg>
        )}
        {badge.icon === 'building' && (
          <svg class={`w-5 h-5 sm:w-6 sm:h-6 ${badge.colorClass}`} fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
          </svg>
        )}
      </div>

      <!-- Текст: на мобильном — под иконкой по центру, на sm+ — в ряд. Без wrap-break-word — иначе разрыв слов (компаний→ко мп ан ий) -->
      <div class="min-w-0 flex-1 w-full overflow-hidden">
        <div class="text-[10px] sm:text-xs text-gray-600 uppercase font-medium tracking-normal sm:tracking-wide leading-tight whitespace-nowrap">{badge.label}</div>
        <div class="text-[11px] sm:text-sm font-bold text-gray-900 leading-tight whitespace-nowrap">{badge.value}</div>
      </div>
    </a>
  ))}
</div>
