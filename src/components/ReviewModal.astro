---
// src/components/ReviewModal.astro
import Modal from './ui/Modal.astro';
import {
  reviewModalLabelClass,
  reviewModalSubmitClass,
  reviewModalTextareaClass,
  reviewModalTextFieldClass,
} from '../lib/form-classes';
---

<Modal id="review-modal" title="Оставить отзыв">
  <form id="review-modal-form" class="space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="review-modal-name" class={reviewModalLabelClass}
          >Имя</label
        >
        <input
          id="review-modal-name"
          type="text"
          name="name"
          required
          autocomplete="name"
          class={reviewModalTextFieldClass}
        />
      </div>
      <div>
        <label for="review-modal-city" class={reviewModalLabelClass}
          >Город</label
        >
        <input
          id="review-modal-city"
          type="text"
          name="city"
          autocomplete="address-level2"
          class={reviewModalTextFieldClass}
        />
      </div>
    </div>

    <fieldset class="border-0 p-0 m-0 min-w-0">
      <legend class={reviewModalLabelClass}>Ваша оценка</legend>
      <div class="flex gap-2">
        {
          [1, 2, 3, 4, 5].map((star) => (
            <label class="cursor-pointer rounded-md focus-within:outline-none focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2">
              <input
                type="radio"
                name="rating"
                value={star}
                id={`review-modal-rating-${star}`}
                class="peer sr-only"
              />
              <svg
                class="w-8 h-8 text-gray-300 peer-checked:text-yellow-400 hover:text-yellow-400 transition-colors"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div>
      <label for="review-modal-text" class={reviewModalLabelClass}
        >Текст отзыва</label
      >
      <textarea
        id="review-modal-text"
        name="review"
        required
        rows="4"
        autocomplete="off"
        class={reviewModalTextareaClass}
      ></textarea>
    </div>

    <button type="submit" class={reviewModalSubmitClass}>
      Отправить отзыв
    </button>
  </form>
</Modal>

<script>
  const reviewForm = document.getElementById('review-modal-form');
  reviewForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    // Отправка на сервер — после подключения API; данные не логируются в консоль (152-ФЗ).
    form.reset();
    (document.getElementById('review-modal') as HTMLDialogElement | null)?.close();
  });
</script>
