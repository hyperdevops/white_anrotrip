---
// src/components/ReviewModal.astro
import Modal from './ui/Modal.astro';
import {
  reviewModalLabelClass,
  reviewModalSubmitClass,
  reviewModalTextareaClass,
  reviewModalTextFieldClass,
} from '../lib/form-classes';
---

<Modal id="review-modal" title="Оставить отзыв">
  <form id="review-modal-form" class="space-y-4">
    {/* Honeypot */}
    <input type="text" name="_hp" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="review-modal-name" class={reviewModalLabelClass}
          >Имя</label
        >
        <input
          id="review-modal-name"
          type="text"
          name="name"
          required
          autocomplete="name"
          class={reviewModalTextFieldClass}
        />
      </div>
      <div>
        <label for="review-modal-city" class={reviewModalLabelClass}
          >Город</label
        >
        <input
          id="review-modal-city"
          type="text"
          name="city"
          autocomplete="address-level2"
          class={reviewModalTextFieldClass}
        />
      </div>
    </div>

    <fieldset class="border-0 p-0 m-0 min-w-0">
      <legend class={reviewModalLabelClass}>Ваша оценка</legend>
      <div class="flex gap-2">
        {
          [1, 2, 3, 4, 5].map((star) => (
            <label class="cursor-pointer rounded-md focus-within:outline-none focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2">
              <input
                type="radio"
                name="rating"
                value={star}
                id={`review-modal-rating-${star}`}
                class="peer sr-only"
              />
              <svg
                class="w-8 h-8 text-gray-300 peer-checked:text-yellow-400 hover:text-yellow-400 transition-colors"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div>
      <label for="review-modal-text" class={reviewModalLabelClass}
        >Текст отзыва</label
      >
      <textarea
        id="review-modal-text"
        name="review"
        required
        rows="4"
        autocomplete="off"
        class={reviewModalTextareaClass}
      ></textarea>
    </div>

    <p id="review-error" class="hidden text-sm text-red-500 text-center" role="alert"></p>

    <button type="submit" id="review-submit" class={reviewModalSubmitClass}>
      Отправить отзыв
    </button>
  </form>

  {/* Экран успеха */}
  <div id="review-success" class="hidden text-center py-6 px-2">
    <div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mx-auto mb-4">
      <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h4 class="font-montserrat text-lg font-bold text-gray-900 mb-2">Спасибо за отзыв!</h4>
    <p class="text-sm text-gray-500">Он поможет другим путешественникам с выбором.</p>
  </div>
</Modal>

<script>
  // Отправка на сервер. Данные не логируются в console.* (152-ФЗ).
  const reviewForm = document.getElementById('review-modal-form') as HTMLFormElement | null;
  const reviewSubmit = document.getElementById('review-submit') as HTMLButtonElement | null;
  const reviewError = document.getElementById('review-error') as HTMLParagraphElement | null;
  const reviewSuccess = document.getElementById('review-success') as HTMLElement | null;
  const reviewDialog = document.getElementById('review-modal') as HTMLDialogElement | null;

  reviewForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!reviewForm || !reviewSubmit) return;

    reviewSubmit.disabled = true;
    reviewSubmit.textContent = 'Отправляем…';
    if (reviewError) { reviewError.textContent = ''; reviewError.classList.add('hidden'); }

    try {
      const res = await fetch('/api/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(reviewForm))),
      });
      const data = await res.json();

      if (data.ok) {
        reviewForm.classList.add('hidden');
        reviewSuccess?.classList.remove('hidden');
        setTimeout(() => { reviewDialog?.close(); }, 3000);
      } else {
        throw new Error(data.error ?? 'Ошибка отправки');
      }
    } catch (err: unknown) {
      if (reviewError) {
        reviewError.textContent = err instanceof Error ? err.message : 'Не удалось отправить. Попробуйте ещё раз.';
        reviewError.classList.remove('hidden');
      }
      reviewSubmit.disabled = false;
      reviewSubmit.textContent = 'Отправить отзыв';
    }
  });
</script>
