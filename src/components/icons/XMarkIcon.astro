---
/** Heroicons outline: X (закрыть модалку, cookie-баннер) */
interface Props {
  iconClass?: string;
  strokeWidth?: number | string;
}
const { iconClass = 'h-5 w-5', strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class:list={[iconClass, 'shrink-0']}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  aria-hidden="true"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width={strokeWidth}
    d="M6 18L18 6M6 6l12 12"></path>
</svg>
