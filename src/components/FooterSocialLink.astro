---
/** Ссылка на соцсеть в футере: иконка в слоте + тултип при hover/focus */
export interface Props {
  href: string;
  ariaLabel: string;
  tooltip: string;
  tooltipTextClass: string;
  linkClass: string;
  tooltipPlacement?: 'top' | 'bottom';
  /** Скрытие тултипа на узкой ширине (подпись под иконкой снаружи) */
  tooltipHideBelowClass?: string;
}

const {
  href,
  ariaLabel,
  tooltip,
  tooltipTextClass,
  linkClass,
  tooltipPlacement = 'top',
  tooltipHideBelowClass = 'max-md:hidden',
} = Astro.props;

const isBottom = tooltipPlacement === 'bottom';

const bubbleClass =
  'max-w-none shrink-0 whitespace-nowrap rounded-lg bg-black px-2.5 py-1.5 text-[11px] font-semibold tracking-tight shadow-[0_10px_28px_-6px_rgba(0,0,0,0.95)] ring-1 ring-white/15';

const shellClass =
  'pointer-events-none absolute left-1/2 z-40 flex -translate-x-1/2 flex-col items-center opacity-0 transition-[opacity,transform] duration-200 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  class:list={['group relative inline-flex shrink-0', linkClass]}
>
  <slot />
  <span
    aria-hidden="true"
    class:list={[
      shellClass,
      isBottom ? 'top-full mt-2 -translate-y-1' : 'bottom-full mb-2 translate-y-1',
      tooltipHideBelowClass,
    ]}
  >
    {
      isBottom && (
        <span
          class="-mb-px h-0 w-0 border-x-[5px] border-b-[6px] border-x-transparent border-b-black"
          aria-hidden="true"
        />
      )
    }
    <span class:list={[bubbleClass, tooltipTextClass]}>{tooltip}</span>
    {
      !isBottom && (
        <span
          class="-mt-px h-0 w-0 border-x-[5px] border-t-[6px] border-x-transparent border-t-black"
          aria-hidden="true"
        />
      )
    }
  </span>
</a>
