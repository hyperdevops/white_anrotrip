---
import { Image } from 'astro:assets';
import favicon from '../assets/favicon.png';
import {
  maxIconPath,
  socialLogoTransform0,
  socialLogoTransform80,
  telegramIconPath,
} from '../lib/social-icons';
import { siteCabinet, siteHome } from '../lib/site-urls';
import PhoneSolidIcon from './PhoneSolidIcon.astro';

export interface Props {
  navItems?: { name: string; href: string }[];
  ctaText?: string;
  ctaHref?: string;
  /** default: на главной — нав по геометрическому центру полосы (lg: 1fr auto 1fr). Иначе — как раньше. corp: своя сетка. */
  navVariant?: 'default' | 'corp';
  /** Круглые кнопки телефона / Telegram / MAX — только главная (`index.astro`). Страницу corp не трогать. */
  homeQuickContacts?: boolean;
}

const HEADER_TG_CHAT = 'https://t.me/anro_trip';
const HEADER_MAX_URL =
  'https://max.ru/u/f9LHodD0cOKNXrTMtvUZWd2zLeGEpz34bQ0i1a-Ur_6EKrIw9H11bR6uhLM';

const base = siteHome();
const baseTrimmed = base.replace(/\/$/, '');
const isHome =
  Astro.url.pathname === '/' ||
  Astro.url.pathname === '' ||
  Astro.url.pathname === baseTrimmed ||
  Astro.url.pathname === baseTrimmed + '/';
/** На главной — якорь к секции «Наш журнал»; на других страницах — переход на главную с хэшем */
const journalHref = isHome ? '#journal' : `${baseTrimmed}/#journal`;
/** CTA «бизнес / travel-ассистент» в About — якорь на главной или переход с других страниц */
const businessHref = isHome ? '#business' : `${baseTrimmed}/#business`;
/** Раздел наград */
const awardsHref = isHome ? '#awards' : `${baseTrimmed}/#awards`;
/** Подарочный сертификат */
const giftHref = isHome ? '#gift' : `${baseTrimmed}/#gift`;

const defaultNavItems = [
  { name: 'Туры', href: '#search' },
  { name: 'Журнал', href: journalHref },
  { name: 'О нас', href: '#about' },
  { name: 'Бизнес', href: businessHref },
  { name: 'Отзывы', href: '#reviews' },
  { name: 'Награды', href: awardsHref },
  { name: 'Подарок', href: giftHref },
  { name: 'Вопросы', href: '#faq' },
  { name: 'Команда', href: '#team' },
  { name: 'Контакты', href: '#contacts' },
];

const {
  navItems = defaultNavItems,
  ctaText = 'Личный кабинет',
  ctaHref = siteCabinet(),
  navVariant = 'default',
  homeQuickContacts = false,
} = Astro.props;

const ctaPrefetch = ctaHref.startsWith('/')
  ? ({ 'data-astro-transition-prefetch': '' } as const)
  : {};

const navDesktopLinkClass =
  'relative px-1.5 lg:px-2 py-1.5 lg:py-2 text-[9px] lg:text-[10px] xl:text-[11px] font-bold text-gray-600 hover:text-primary uppercase tracking-wide whitespace-nowrap transition-colors duration-fast rounded-lg hover:bg-primary/5 group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

const mobileNavRowBase =
  'flex items-center rounded-xl px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-primary/8 hover:text-primary transition-[background-color,color] duration-fast cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
const mobileNavItemClass = `${mobileNavRowBase} gap-3`;
const mobileTelRowClass = `${mobileNavRowBase} gap-2`;

/** Круглые кнопки связи (только главная): общая база, как у соцкнопок в OfficeWidget/Footer */
const homeContactBtnBase =
  'inline-flex shrink-0 items-center justify-center rounded-full shadow-sm transition-colors duration-fast focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2';
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-[transform,opacity] duration-normal"
>
  <div
    class:list={[
      'mx-auto px-3 sm:px-4 pt-3 md:pt-4',
      navVariant === 'corp'
        ? 'max-w-7xl'
        : homeQuickContacts
          ? 'max-w-[1400px]'
          : 'max-w-[1360px]',
    ]}
  >
    <div
      id="header-inner"
      class:list={[
        'relative grid items-center gap-2 lg:gap-3 rounded-2xl glass-panel max-md:backdrop-blur-none md:backdrop-blur-xl px-3 sm:px-4 py-2.5 md:py-3 transition-[background-color,border-color,box-shadow] duration-normal',
        navVariant === 'corp'
          ? 'grid-cols-[auto_minmax(0,1fr)_auto]'
          : isHome
            ? 'grid-cols-[auto_1fr_auto] lg:grid-cols-[1fr_auto_1fr]'
            : 'grid-cols-[auto_1fr_auto]',
      ]}
    >
      {
        /* Логотип: на главной — scroll to top; на corp/cabinet — data-astro-reload (полная перезагрузка для Tourvisor) */
      }
      <a
        href={isHome ? '#' : base}
        id="logo-btn"
        class:list={[
          'flex items-center gap-3 group z-50 cursor-pointer select-none',
          isHome && navVariant === 'default' ? 'lg:justify-self-start' : '',
        ]}
        {...isHome ? {} : { 'data-astro-reload': true }}
      >
        <Image
          src={favicon}
          alt=""
          width={40}
          height={40}
          format="png"
          densities={[2, 3, 4]}
          quality="max"
          decoding="async"
          class="h-10 w-10 shrink-0 object-contain drop-shadow-sm"
        />

        <div
          class="header-logo-text flex flex-col leading-none group-hover:scale-105 origin-left"
        >
          <div class="flex items-baseline gap-0.5">
            <span
              class="text-[15px] font-black tracking-tight text-black font-montserrat"
              >ANRO</span
            >
            <span
              class="text-[15px] font-semibold italic font-montserrat text-primary"
              >trip</span
            >
          </div>
          <span
            class="text-[9px] sm:text-[8px] text-gray-400 uppercase tracking-widest hidden sm:block"
            >Travel &amp; Business</span
          >
        </div>
      </a>

      <nav
        class:list={[
          'hidden lg:flex items-center justify-center min-w-0 gap-x-1.5 lg:gap-x-1.5 overflow-visible',
          isHome && navVariant === 'default' ? 'justify-self-center' : '',
        ]}
        aria-label="Основное меню"
      >
        {
          navItems.map((item, index) => (
            <>
              <a
                href={item.href}
                class={navDesktopLinkClass}
                style="-webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-wrap-mode: nowrap;"
              >
                {item.name}
                <span class="absolute bottom-1 left-2 right-2 h-px bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-normal origin-left" />
              </a>
              {index < navItems.length - 1 ? (
                <span
                  class="w-0.5 h-0.5 lg:w-1 lg:h-1 shrink-0 rounded-full bg-primary self-center"
                  aria-hidden="true"
                />
              ) : null}
            </>
          ))
        }
      </nav>

      {/* col-start-3 фиксирует бургер справа на mobile при скрытой nav */}
      <div
        class="col-start-3 flex items-center justify-end gap-1.5 sm:gap-2 z-50 justify-self-end shrink-0"
      >
        {
          homeQuickContacts ? (
            <>
              <div
                class="flex lg:hidden items-center gap-1 shrink-0"
                role="group"
                aria-label="Связь: телефон, Telegram, MAX"
              >
                <a
                  href="tel:88002224473"
                  class:list={[
                    homeContactBtnBase,
                    'h-7 w-7 bg-primary text-white hover:bg-primary-dark focus-visible:ring-primary focus-visible:ring-offset-white',
                  ]}
                  aria-label="Позвонить: 8 800 222-44-73"
                >
                  <PhoneSolidIcon
                    iconClass="w-3.5 h-3.5"
                    colorClass="text-white"
                  />
                </a>
                <a
                  href={HEADER_TG_CHAT}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    homeContactBtnBase,
                    'h-7 w-7 bg-[#0087cb] text-white hover:bg-[#0074b0] focus-visible:ring-sky-400 focus-visible:ring-offset-white',
                  ]}
                  aria-label="Написать в Telegram — чат ANRO TRIP"
                >
                  <svg
                    class="h-5 w-5 shrink-0 text-white"
                    viewBox="0 0 80 80"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <g transform={socialLogoTransform0}>
                      <path
                        fill="currentColor"
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d={telegramIconPath}
                      />
                    </g>
                  </svg>
                </a>
                <a
                  href={HEADER_MAX_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    homeContactBtnBase,
                    'h-7 w-7 bg-[#7b3dec] text-white hover:bg-[#6829d4] focus-visible:ring-violet-400 focus-visible:ring-offset-white',
                  ]}
                  aria-label="Открыть в MAX"
                >
                  <svg
                    class="h-[14px] w-[14px] shrink-0 text-white"
                    viewBox="80 80 80 80"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <g transform={socialLogoTransform80}>
                      <path
                        fill="currentColor"
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d={maxIconPath}
                      />
                    </g>
                  </svg>
                </a>
              </div>
              <a
                href="tel:88002224473"
                class="hidden lg:flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold text-gray-700 hover:text-primary hover:bg-primary/5 transition-[color,background-color] duration-fast whitespace-nowrap cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <PhoneSolidIcon
                  iconClass="w-3.5 h-3.5"
                  colorClass="text-primary"
                />
                8 (800) 222-44-73
              </a>
            </>
          ) : (
            <a
              href="tel:88002224473"
              class="hidden 2xl:flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold text-gray-700 hover:text-primary hover:bg-primary/5 transition-[color,background-color] duration-fast whitespace-nowrap cursor-pointer"
            >
              <PhoneSolidIcon
                iconClass="w-3.5 h-3.5"
                colorClass="text-primary"
              />
              8 (800) 222-44-73
            </a>
          )
        }

        <a
          href={ctaHref}
          class="header-cta-btn btn-ripple hidden lg:inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-xs font-bold text-white hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/30 uppercase tracking-wide shadow-md cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 whitespace-nowrap"
          {...ctaPrefetch}
        >
          {ctaText}
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden flex flex-col gap-1.25 p-2 group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-lg"
          aria-label="Меню"
          aria-expanded="false"
        >
          <span
            class="h-0.5 w-5 bg-gray-700 rounded-full transition-[transform,opacity] duration-fast origin-center"
          ></span>
          <span
            class="h-0.5 w-5 bg-gray-700 rounded-full transition-[transform,opacity] duration-fast"
          ></span>
          <span
            class="h-0.5 w-3.5 bg-gray-700 rounded-full transition-[transform,opacity] duration-fast origin-center self-end"
          ></span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed top-20 right-4 w-56 bg-white/95 rounded-2xl border border-white/40 shadow-2xl shadow-black/15 lg:hidden z-40 transition-[opacity,transform] duration-250 ease-out opacity-0 -translate-y-3 pointer-events-none"
  >
    <nav class="flex flex-col p-2" aria-label="Меню">
      <ul class="flex flex-col gap-0.5">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class={mobileNavItemClass}>
                <span class="w-1 h-1 rounded-full bg-primary shrink-0" />
                {item.name}
              </a>
              {item.name === 'Контакты' && navVariant !== 'corp' ? (
                <button
                  id="open-favorites-menu"
                  type="button"
                  class:list={[mobileNavItemClass, 'mt-0.5 w-full']}
                  aria-label="Открыть избранное (корзину туров)"
                >
                  <span class="w-1 h-1 rounded-full bg-primary shrink-0" />
                  Избранное
                </button>
              ) : null}
            </li>
          ))
        }
      </ul>
      <div class="my-1.5 h-px bg-gray-100 mx-2"></div>
      {
        !homeQuickContacts ? (
          <a href="tel:88002224473" class={mobileTelRowClass}>
            <PhoneSolidIcon iconClass="w-4 h-4" colorClass="text-primary" />8
            (800) 222-44-73
          </a>
        ) : null
      }
      <a
        href={ctaHref}
        class="header-cta-btn btn-ripple mx-2 mb-1 mt-0.5 rounded-xl bg-primary px-4 py-3 text-center text-sm font-bold text-white hover:bg-primary-dark cursor-pointer whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        {...ctaPrefetch}
      >
        {ctaText}
      </a>
    </nav>
  </div>
</header>

<script>
  let toggleBtn = document.getElementById(
    'menu-toggle',
  ) as HTMLButtonElement | null;
  let menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const logoBtn = document.getElementById(
    'logo-btn',
  ) as HTMLAnchorElement | null;
  let headerInner = document.getElementById(
    'header-inner',
  ) as HTMLElement | null;
  let menuOpen = false;
  let toggleClickHandler: ((e: Event) => void) | null = null;

  /** Синхронизирует --site-header-h для scroll-mt calc() в секциях Awards, Gift, Business */
  const syncHeaderHeightVar = () => {
    const el = document.getElementById('site-header');
    if (el)
      document.documentElement.style.setProperty(
        '--site-header-h',
        `${el.offsetHeight}px`,
      );
  };
  syncHeaderHeightVar();
  window.addEventListener('resize', syncHeaderHeightVar);

  // Прокрутка к якорям: Desktop — только #search и #content; Mobile — все пункты меню
  const initAnchorScroll = () => {
    syncHeaderHeightVar();
    const headerEl = document.getElementById('site-header');
    const headerHeight = headerEl ? headerEl.offsetHeight : 64;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;

    if (!isMobile) {
      document
        .querySelectorAll<HTMLAnchorElement>('header a[href="#search"]')
        .forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const anchor = document.getElementById('search');
            if (anchor) {
              const top =
                anchor.getBoundingClientRect().top + window.scrollY - 78;
              window.scrollTo({ top, behavior: 'smooth' });
            }
          });
        });

      const GAP_PX = 22;
      document
        .querySelectorAll<HTMLAnchorElement>('header a[href="#content"]')
        .forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const anchor = document.getElementById('content');
            if (anchor) {
              const offset = headerHeight + GAP_PX;
              const top =
                anchor.getBoundingClientRect().top + window.scrollY - offset;
              window.scrollTo({ top, behavior: 'smooth' });
            }
          });
        });
      return;
    }

    const GAP_PX = -28;
    const SEARCH_GAP = -16; // хедер + минимальный зазор до search widget
    const CORP_CONTENT_GAP = -28;
    // Секция py-14 (56px) на мобиле: пилюля на 30px ниже хедера → offset = headerHeight - 26
    const BUSINESS_GAP = -26;
    // Секции py-16 (64px) на мобиле: пилюля на 60px ниже хедера → offset = headerHeight - 4
    const AWARDS_GIFT_GAP = -4;

    const scrollToAnchor = (e: Event, href: string) => {
      const raw =
        href.indexOf('#') >= 0 ? href.slice(href.indexOf('#') + 1) : '';
      const id = raw;
      if (!id) return;
      const anchor = document.getElementById(id);
      if (!anchor) return;
      e.preventDefault();
      let offset: number;
      if (id === 'search') offset = headerHeight + SEARCH_GAP;
      else if (id === 'content') offset = headerHeight + CORP_CONTENT_GAP;
      else if (id === 'business') offset = headerHeight + BUSINESS_GAP;
      else if (id === 'awards' || id === 'gift')
        offset = headerHeight + AWARDS_GIFT_GAP;
      else offset = headerHeight + GAP_PX;
      const top = anchor.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
      if (menuOpen && menu) closeMenu();
    };

    document
      .querySelectorAll<HTMLAnchorElement>('header a[href^="#"]:not(#logo-btn)')
      .forEach((link) => {
        const href = link.getAttribute('href') || '';
        link.addEventListener('click', (e) => scrollToAnchor(e, href));
      });
  };
  initAnchorScroll();
  document.addEventListener('astro:page-load', initAnchorScroll);

  const onScroll = () => {
    if (window.scrollY > 40) {
      headerInner?.classList.add('shadow-xl', 'shadow-black/10');
      headerInner?.classList.remove('shadow-none');
    } else {
      headerInner?.classList.remove('shadow-xl', 'shadow-black/10');
      headerInner?.classList.add('shadow-none');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const initLogoClick = () => {
    const logo = document.getElementById('logo-btn');
    if (logo?.hasAttribute('data-astro-reload')) return;
    logo?.addEventListener('click', (e) => {
      e.preventDefault();
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      const basePath = document.body.dataset.base?.replace(/\/$/, '') || '/';
      document.documentElement.style.transition = 'opacity 0.5s ease';
      document.body.style.transition = 'opacity 0.5s ease';
      document.documentElement.style.opacity = '0';
      document.body.style.opacity = '0';
      const isHomePath =
        path === '/' ||
        path === '/index.html' ||
        path === basePath ||
        path === basePath + '/';
      if (!isHomePath) {
        setTimeout(() => {
          window.location.href = document.body.dataset.base || '/';
        }, 500);
      } else {
        setTimeout(() => {
          window.scrollTo({ top: 0, behavior: 'instant' });
          document
            .querySelectorAll('.reveal-visible')
            .forEach((el) => el.classList.remove('reveal-visible'));
          if (window.initScrollReveal) window.initScrollReveal();
          setTimeout(() => {
            document.documentElement.style.opacity = '1';
            document.body.style.opacity = '1';
            setTimeout(() => {
              document.documentElement.style.transition = '';
              document.documentElement.style.opacity = '';
              document.body.style.transition = '';
              document.body.style.opacity = '';
            }, 500);
          }, 80);
        }, 500);
      }
    });
  };
  initLogoClick();
  document.addEventListener('astro:page-load', initLogoClick);

  const openMenu = () => {
    if (!menu || !toggleBtn) return;
    menuOpen = true;
    menu.classList.remove('opacity-0', '-translate-y-3', 'pointer-events-none');
    menu.classList.add('opacity-100', 'translate-y-0');
    toggleBtn.setAttribute('aria-expanded', 'true');
    const bars = toggleBtn.querySelectorAll('span');
    bars[0]?.classList.add('rotate-45', 'translate-y-[7px]');
    bars[1]?.classList.add('opacity-0', 'scale-x-0');
    bars[2]?.classList.add(
      '-rotate-45',
      '-translate-y-[7px]',
      'w-5',
      'self-auto',
    );
  };

  const closeMenu = () => {
    if (!menu || !toggleBtn) return;
    const menuEl = menu;
    menuOpen = false;
    toggleBtn.setAttribute('aria-expanded', 'false');
    menuEl.style.transition = 'none';
    menuEl.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
    menuEl.classList.remove('opacity-100', 'translate-y-0');
    requestAnimationFrame(() => {
      menuEl.style.transition = '';
    });
    const bars = toggleBtn.querySelectorAll('span');
    bars.forEach((b) => ((b as HTMLElement).style.transition = 'none'));
    bars[0]?.classList.remove('rotate-45', 'translate-y-[7px]');
    bars[1]?.classList.remove('opacity-0', 'scale-x-0');
    bars[2]?.classList.remove(
      '-rotate-45',
      '-translate-y-[7px]',
      'w-5',
      'self-auto',
    );
    requestAnimationFrame(() => {
      bars.forEach((b) => ((b as HTMLElement).style.transition = ''));
    });
  };

  const initMobileMenu = () => {
    toggleBtn = document.getElementById(
      'menu-toggle',
    ) as HTMLButtonElement | null;
    menu = document.getElementById('mobile-menu') as HTMLElement | null;
    headerInner = document.getElementById('header-inner') as HTMLElement | null;
    onScroll();
    if (typeof window !== 'undefined' && window.innerWidth >= 1024) return;
    if (!toggleBtn || !menu) return;

    menuOpen = false;
    menu.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
    menu.classList.remove('opacity-100', 'translate-y-0');
    toggleBtn.setAttribute('aria-expanded', 'false');
    const bars = toggleBtn.querySelectorAll('span');
    bars[0]?.classList.remove('rotate-45', 'translate-y-[7px]');
    bars[1]?.classList.remove('opacity-0', 'scale-x-0');
    bars[2]?.classList.remove(
      '-rotate-45',
      '-translate-y-[7px]',
      'w-5',
      'self-auto',
    );

    if (toggleClickHandler)
      toggleBtn.removeEventListener('click', toggleClickHandler);
    toggleClickHandler = (e: Event) => {
      e.stopPropagation();
      menuOpen ? closeMenu() : openMenu();
    };
    toggleBtn.addEventListener('click', toggleClickHandler);

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    const favoritesBtn = document.getElementById(
      'open-favorites-menu',
    ) as HTMLButtonElement | null;
    favoritesBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const w = window as Window & { openFavoritesWidget?: () => void };
      w.openFavoritesWidget?.();
      closeMenu();
    });
  };
  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (menuOpen && menu && target instanceof Node) {
      if (!menu.contains(target) && !toggleBtn?.contains(target)) {
        closeMenu();
      }
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      closeMenu();
      toggleBtn?.focus();
    }
  });
</script>
