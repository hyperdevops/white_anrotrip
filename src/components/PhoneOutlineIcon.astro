---
/**
 * Телефон — Font Awesome Solid (единый стиль с остальным UI).
 * iconClass: кегль, напр. text-base, text-xl, text-2xl
 */
interface Props {
  iconClass?: string;
  colorClass?: string;
  /** Оставлено для обратной совместимости со старыми вызовами (SVG stroke). */
  strokeWidth?: number | string;
}
const { iconClass = 'text-base', colorClass = 'text-primary' } = Astro.props;
---

<i
  class:list={['fa-solid fa-phone shrink-0 leading-none', iconClass, colorClass]}
  aria-hidden="true"
></i>
