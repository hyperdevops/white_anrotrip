---
import { Icon } from 'astro-iconify';

interface Props {
  iconClass?: string;
  colorClass?: string;
  /** Оставлено для обратной совместимости со старыми вызовами (SVG stroke). */
  strokeWidth?: number | string;
}
const { iconClass = 'text-base', colorClass = 'text-primary' } = Astro.props;
---

<Icon
  name="fa6-solid:phone"
  class:list={[iconClass, colorClass, 'inline-block shrink-0 align-[-0.125em] leading-none']}
  style="width: 1em; height: 1em;"
  aria-hidden="true"
/>
