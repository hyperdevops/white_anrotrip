---
// src/components/widgets/TourvisorSearch.astro
// Legacy-компонент: на главной используется SearchWidget.astro (lazy-load при вкладке «Туры»).
// Здесь — отложенная загрузка init.js без блокировки первого экрана.
---

<div class="tv-wrapper w-full bg-white rounded-xl min-h-112.5">
  <div class="tv-search-form tv-moduleid-192367"></div>
</div>

<script is:inline>
  const TOURVISOR_SCRIPT_URL = 'https://tourvisor.ru/module/init.js';

  function loadTourvisorScript() {
    if (window.__tourvisorScriptPromise) return window.__tourvisorScriptPromise;

    window.__tourvisorScriptPromise = new Promise(function (resolve, reject) {
      if (document.querySelector('script[data-tourvisor-init]')) {
        resolve();
        return;
      }

      var s = document.createElement('script');
      s.src = TOURVISOR_SCRIPT_URL;
      s.async = true;
      s.defer = true;
      s.dataset.tourvisorInit = '1';
      s.onload = function () {
        resolve();
      };
      s.onerror = function () {
        reject(new Error('Tourvisor init.js failed to load'));
      };
      document.body.appendChild(s);
    });

    return window.__tourvisorScriptPromise;
  }

  function initTourvisorWidget() {
    var container = document.querySelector('.tv-search-form.tv-moduleid-192367');
    if (!container) return;

    var boot = function () {
      loadTourvisorScript()
        .then(function () {
          requestAnimationFrame(function () {
            window.dispatchEvent(new Event('resize'));
          });
        })
        .catch(function () {
          /* виджет не критичен для первого экрана */
        });
    };

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(
        function (entries) {
          if (entries.some(function (entry) {
            return entry.isIntersecting;
          })) {
            observer.disconnect();
            boot();
          }
        },
        { rootMargin: '200px 0px' },
      );
      observer.observe(container);
      return;
    }

    boot();
  }

  window.initTourvisorWidget = initTourvisorWidget;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTourvisorWidget);
  } else {
    initTourvisorWidget();
  }
</script>
