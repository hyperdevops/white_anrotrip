---
export interface Props { class?: string; }
const { class: classes = '' } = Astro.props;

const tabs = ['Турция', 'Таиланд', 'Египет', 'Вьетнам', 'Россия'];
const cardsPerTab = 5; // Количество карточек-заглушек в каждой вкладке
---

<section class={`py-[50px] bg-white ${classes}`}>
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl">

    <!-- Заголовок и Вкладки -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal-hidden">
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/8 border border-primary/15 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-primary md:animate-pulse"></span>
          <span class="text-xs font-semibold text-primary uppercase tracking-widest font-montserrat">Подборки</span>
        </div>
        <h2 class="font-montserrat font-extrabold text-gray-900 uppercase tracking-tight leading-none" style="font-size: clamp(2rem, 1.5rem + 3vw, 4rem);">
          Подборка<br /><span class="text-primary">туров</span>
        </h2>
      </div>

      <!-- Вкладки (Tabs) -->
      <div class="flex overflow-x-auto hide-scrollbar gap-2 p-1.5 bg-gray-50 rounded-2xl border border-gray-100 max-w-full">
        {tabs.map((tab, index) => (
          <button
            type="button"
            data-tab-target={`hotels-tab-${index}`}
            class={`px-5 py-2.5 rounded-xl text-sm font-semibold whitespace-nowrap transition-all duration-fast ${
              index === 0
                ? 'bg-white text-primary shadow-sm border border-gray-200/50'
                : 'text-gray-600 hover:text-primary hover:bg-white/60 border border-transparent'
            }`}
          >
            {tab}
          </button>
        ))}
      </div>
    </div>

    <!-- Содержимое вкладок -->
    <div class="relative reveal-hidden">
      {tabs.map((tab, tabIndex) => (
        <div
          id={`hotels-tab-${tabIndex}`}
          class={`hotels-tab-content transition-opacity duration-300 ${tabIndex === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
        >
          <!-- Обертка слайдера со стрелками -->
          <div class="relative group">

            <!-- Левая стрелка (скрыта на мобильных, появляется при скролле вправо) -->
            <button
              type="button"
              class="hotels-slider-left absolute left-0 top-[40%] -translate-y-1/2 -translate-x-4 lg:-translate-x-6 z-10 w-12 h-12 bg-white rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.12)] hidden md:flex items-center justify-center text-gray-600 hover:text-primary hover:scale-110 transition-all focus:outline-none border border-gray-100"
              aria-label="Назад"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <!-- Контейнер с карточками -->
            <div class="hotels-slider flex gap-4 md:gap-5 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-8 pt-2 px-2 -mx-2">
              {Array.from({ length: cardsPerTab }).map((_, cardIndex) => (
                <div class="snap-start shrink-0 w-[260px] sm:w-[300px] bg-white rounded-3xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgba(0,171,179,0.12)] border border-gray-100 transition-shadow duration-normal flex flex-col group/card cursor-pointer">

                  <!-- ЗАГЛУШКА ДЛЯ ИЗОБРАЖЕНИЯ -->
                  <!--
                    ИНСТРУКЦИЯ ПО ЗАМЕНЕ НА РЕАЛЬНЫЕ ФОТО:
                    1. Импортируйте картинку в начале файла:
                       import tourImg1 from '../assets/tours/tour-1.webp';
                    2. Замените этот <div> на компонент <Image>:
                       <Image src={tourImg1} alt="Название тура" class="w-full h-full object-cover transition-transform duration-slow group-hover/card:scale-105" width={400} height={300} />
                  -->
                  <div class="h-48 bg-gray-100 relative flex items-center justify-center overflow-hidden">
                    <div class="absolute inset-0 bg-gray-200 transition-transform duration-slow group-hover/card:scale-105"></div>
                    <span class="text-gray-400 font-medium text-sm z-10 relative"><i class="fa-regular fa-image mr-2"></i>Фото тура</span>

                    <!-- Бейдж рейтинга -->
                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg text-xs font-bold text-gray-800 flex items-center gap-1 z-10">
                      <i class="fa-solid fa-star text-amber-400 text-[10px]"></i> 5.0
                    </div>
                  </div>

                  <!-- Контент карточки -->
                  <div class="p-5 flex flex-col grow">
                    <div class="text-xs text-gray-500 mb-2 flex items-center gap-1.5">
                      <i class="fa-solid fa-location-dot text-primary/70"></i>
                      {tab}, Курорт
                    </div>

                    <h3 class="font-bold text-gray-900 text-lg mb-2 leading-tight group-hover/card:text-primary transition-colors duration-fast">
                      {tab} {cardIndex + 1}
                    </h3>

                    <p class="text-sm text-gray-500 mb-4 line-clamp-2">
                      Краткое описание тура. Здесь будет информация о перелете, проживании и экскурсиях.
                    </p>

                    <div class="mt-auto flex items-center justify-between pt-4 border-t border-gray-50">
                      <div>
                        <span class="text-[10px] text-gray-400 block uppercase font-semibold tracking-wider mb-0.5">Стоимость</span>
                        <span class="font-bold text-gray-900 text-lg leading-none">от 100 000 ₽</span>
                      </div>
                      <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center group-hover/card:bg-primary group-hover/card:text-white transition-colors duration-fast">
                        <i class="fa-solid fa-arrow-right -rotate-45 group-hover/card:rotate-0 transition-transform duration-normal"></i>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Правая стрелка (скрыта на мобильных) -->
            <button
              type="button"
              class="hotels-slider-right absolute right-0 top-[40%] -translate-y-1/2 translate-x-4 lg:translate-x-6 z-10 w-12 h-12 bg-white rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.12)] hidden md:flex items-center justify-center text-gray-600 hover:text-primary hover:scale-110 transition-all focus:outline-none border border-gray-100"
              aria-label="Вперед"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </button>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Скрытие стандартного скроллбара для красивого горизонтального скролла */
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initRecommendedHotels() {
    // 1. Логика переключения вкладок
    const tabButtons = document.querySelectorAll('[data-tab-target]');
    const tabContents = document.querySelectorAll('.hotels-tab-content');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Сбрасываем активное состояние у всех кнопок
        tabButtons.forEach(btn => {
          btn.classList.remove('bg-white', 'text-primary', 'shadow-sm', 'border-gray-200/50');
          btn.classList.add('text-gray-600', 'hover:text-primary', 'hover:bg-white/60', 'border-transparent');
        });

        // Делаем нажатую кнопку активной
        button.classList.remove('text-gray-600', 'hover:text-primary', 'hover:bg-white/60', 'border-transparent');
        button.classList.add('bg-white', 'text-primary', 'shadow-sm', 'border-gray-200/50');

        // Скрываем все вкладки
        tabContents.forEach(content => {
          content.classList.remove('block', 'opacity-100');
          content.classList.add('hidden', 'opacity-0');
        });

        // Показываем нужную вкладку
        const targetId = (button as HTMLElement).dataset.tabTarget;
        if (targetId) {
          const targetContent = document.getElementById(targetId);
          if (targetContent) {
            targetContent.classList.remove('hidden');
            // Небольшая задержка для плавного появления (opacity transition)
            setTimeout(() => {
              targetContent.classList.remove('opacity-0');
              targetContent.classList.add('block', 'opacity-100');
            }, 20);
          }
        }
      });
    });

    // 2. Логика горизонтального скролла по стрелкам
    const sliders = document.querySelectorAll('.hotels-slider');

    sliders.forEach(slider => {
      const container = slider.parentElement;
      if (!container) return;

      const leftBtn = container.querySelector('.hotels-slider-left') as HTMLButtonElement;
      const rightBtn = container.querySelector('.hotels-slider-right') as HTMLButtonElement;

      if (!leftBtn || !rightBtn) return;

      // Ширина карточки + gap (примерно)
      const scrollAmount = 320;

      leftBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      rightBtn.addEventListener('click', () => {
        slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });

      // Обновление видимости стрелок в зависимости от позиции скролла
      const updateArrows = () => {
        // Левая стрелка
        if (slider.scrollLeft <= 10) {
          leftBtn.style.display = 'none';
        } else {
          leftBtn.style.display = ''; // Возвращаем класс из CSS (flex)
        }

        // Правая стрелка
        if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10) {
          rightBtn.style.display = 'none';
        } else {
          rightBtn.style.display = '';
        }
      };

      slider.addEventListener('scroll', updateArrows);
      // Инициализация при загрузке
      updateArrows();
      // Обновление при ресайзе окна
      window.addEventListener('resize', updateArrows);
    });
  }

  // Запускаем скрипт при первой загрузке и после навигации View Transitions
  initRecommendedHotels();
  document.addEventListener('astro:page-load', initRecommendedHotels);
</script>
