---
/**
 * Минимальный подвал для юридических страниц: копирайт + ссылки на политику и соглашение.
 */
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer
  id="site-footer"
  class="border-t border-white/10 bg-gray-950 text-white"
  aria-label="Подвал страницы"
>
  <div
    class="container mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-4 sm:flex-row sm:gap-4 sm:px-6 sm:py-5"
  >
    <p
      class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-center text-[11px] leading-snug text-white/50 sm:justify-start sm:text-left"
    >
      <span class="font-montserrat font-bold tracking-tight text-white/90">
        ANRO <span class="text-primary">TRIP</span>
      </span>
      <span class="text-white/25" aria-hidden="true">·</span>
      <span>© {currentYear} · Туристическая компания</span>
    </p>
    <nav
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[11px] text-white/45"
      aria-label="Юридическая информация"
    >
      <a
        href={`${base}privacy`}
        class="transition-colors hover:text-white/75 focus:outline-none focus-visible:text-white focus-visible:underline"
        >Конфиденциальность</a
      >
      <span class="text-white/25" aria-hidden="true">·</span>
      <a
        href={`${base}terms`}
        class="transition-colors hover:text-white/75 focus:outline-none focus-visible:text-white focus-visible:underline"
        >Соглашение</a
      >
    </nav>
  </div>
</footer>
