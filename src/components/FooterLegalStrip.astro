---
/** Подвал privacy/terms: копирайт + ссылки */
import { sitePrivacy, siteTerms } from '../lib/site-urls';

const currentYear = new Date().getFullYear();

const linkClass =
  'transition-colors hover:text-white/75 focus:outline-none focus-visible:text-white focus-visible:underline';

const legalLinks = [
  { href: sitePrivacy(), label: 'Конфиденциальность' },
  { href: siteTerms(), label: 'Соглашение' },
] as const;
---

<footer
  id="site-footer"
  class="border-t border-white/10 bg-gray-950 text-white"
  aria-label="Подвал страницы"
>
  <div
    class="container mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-4 sm:flex-row sm:gap-4 sm:px-6 sm:py-5"
  >
    <p
      class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-center text-[11px] leading-snug text-white/60 sm:justify-start sm:text-left"
    >
      <span class="font-montserrat font-bold tracking-tight text-white">
        ANRO <span class="font-semibold italic text-primary">TRIP</span>
      </span>
      <span class="text-white/25" aria-hidden="true">·</span>
      <span>© {currentYear} · Туристическая компания</span>
    </p>
    <nav
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[11px] text-white/60"
      aria-label="Юридическая информация"
    >
      {legalLinks.map(({ href, label }, i) => (
        <>
          {i > 0 && <span class="text-white/25" aria-hidden="true">·</span>}
          <a href={href} class={linkClass}>{label}</a>
        </>
      ))}
    </nav>
  </div>
</footer>
