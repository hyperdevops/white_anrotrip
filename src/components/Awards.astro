---
// src/components/Awards.astro
import { Image } from 'astro:assets';
import clickvoyageAward from '../assets/awards/clickvoyage.webp';
import leftAward from '../assets/awards/maestro.webp';
import maxxVoyage01 from '../assets/awards/maxx-voyage/01.webp';
import maxxVoyage02 from '../assets/awards/maxx-voyage/02.webp';
import maxxVoyage03 from '../assets/awards/maxx-voyage/03.webp';
import maxxVoyage04 from '../assets/awards/maxx-voyage/04.webp';
import maxxVoyage05 from '../assets/awards/maxx-voyage/05.webp';
import maxxVoyage06 from '../assets/awards/maxx-voyage/06.webp';
import maxxVoyage07 from '../assets/awards/maxx-voyage/07.webp';
import maxxVoyage08 from '../assets/awards/maxx-voyage/08.webp';
import maxxVoyage09 from '../assets/awards/maxx-voyage/09.webp';
import maxxVoyage10 from '../assets/awards/maxx-voyage/10.webp';
import maxxVoyage11 from '../assets/awards/maxx-voyage/11.webp';
import maxxVoyage12 from '../assets/awards/maxx-voyage/12.webp';
import rightAward from '../assets/awards/phaselis.webp';

const maxxVoyageImages = [
  maxxVoyage01,
  maxxVoyage02,
  maxxVoyage03,
  maxxVoyage04,
  maxxVoyage05,
  maxxVoyage06,
  maxxVoyage07,
  maxxVoyage08,
  maxxVoyage09,
  maxxVoyage10,
  maxxVoyage11,
  maxxVoyage12,
];

const maxxAward = {
  title: 'MAXX ROYAL и VOYAGE Hotels',
  cardImage: maxxVoyage04,
  images: maxxVoyageImages,
  cardRank: 'Топ продаж',
  ribbonRank: 'Лучшие из лучших',
  accent: 'bg-primary',
  description:
    'Сеть отелей VOYAGE Hotels неоднократно отмечала нас на своих церемониях, как лидеров продаж:',
  results: [
    { place: '2020', geo: 'TOP Seller Agency' },
    { place: '2023', geo: 'TOP Seller Agency' },
  ],
  partnerNote:
    'По итогам 2024 года на церемонии MAXX ROYAL ANRO TRIP заняли 2 место по УрФО. Первое участие в церемонии —<br />и сразу такая высокая награда!',
};

const awards = [
  {
    title: '«Маэстро путешествий»',
    image: leftAward,
    rank: 'Партнер холдинга',
    accent: 'bg-red',
    description:
      'Наша компания ANRO TRIP уже три раза была участницей премии «Маэстро путешествий» от холдинга «Русский Экспресс»:',
    results: [
      { place: '2023 год', geo: '20 место*' },
      { place: '2024 год', geo: '1 место по УрФО' },
      { place: '2025 год', geo: '7 место*' },
    ],
    footnote:
      '* рейтинг по регионам России (все субъекты, кроме Москвы и Санкт-Петербурга) среди 14 000 агентств',
    partnerNote:
      'Также имеем высший статус сотрудничества с холдингом — Партнёр Русского Экспресса.',
  },
  {
    title: maxxAward.title,
    image: maxxAward.cardImage,
    rank: maxxAward.cardRank,
    accent: maxxAward.accent,
    description: maxxAward.description,
    results: maxxAward.results,
    partnerNote: maxxAward.partnerNote,
  },
  {
    title: 'NG PHASELIS BAY',
    image: rightAward,
    rank: '4 года Best Seller',
    accent: 'bg-gray-400',
    description:
      'С 2022 года ежегодно становимся участниками церемонии награждения SEE.FEEL.LOVE в отеле NG PHASELIS BAY:',
    results: [
      { place: '2022', geo: 'Best Seller' },
      { place: '2023', geo: 'Best Seller' },
      { place: '2024', geo: 'Best Seller' },
      { place: '2025', geo: 'Best Seller' },
    ],
  },
  {
    title: 'CLICKVOYAGE',
    image: clickvoyageAward,
    rank: 'Лидер продаж',
    accent: 'bg-primary',
    description:
      'По итогам сезона 2025/26 ANRO TRIP стала единственной компанией из Челябинска и Екатеринбурга, которая приняла участие в церемонии награждения лидеров туроператора ClickVoyage в Москве и получила награду:',
    results: [
      { place: '2026', geo: 'Лидер продаж премиальных туров' },
    ],
  },
];
---

<section
  id="awards"
  class="relative py-[50px] bg-white overflow-hidden scroll-mt-[calc(var(--site-header-h,5rem)-30px)]"
>
  <!-- Декор -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-none md:blur-3xl pointer-events-none translate-x-1/2 -translate-y-1/2"></div>

  <div class="container mx-auto px-4 sm:px-6 max-w-7xl">

    <!-- Заголовок -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 md:mb-8 reveal-hidden">
      <div>
        <div class="section-badge mb-4">
          <svg class="section-badge__icon" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
          <span class="section-badge__label">Наши достижения</span>
        </div>
        <h2 class="section-heading-plus font-montserrat font-extrabold text-gray-900 uppercase tracking-tight">
          Награды<br />
          <span class="text-primary">ANRO TRIP</span>
        </h2>
      </div>
      <p class="section-caption">
        Признание профессионального сообщества и крупнейших туристических холдингов России
      </p>
    </div>

    <!-- Карточки наград -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6 items-start" data-reveal-stagger>
      {awards.map((award) => (
        <div class="reveal-hidden">
          <div class="awards-card group relative bg-white rounded-3xl overflow-hidden border border-gray-100 transition-[box-shadow,border-color] duration-slow ease-out">
          <!-- Фото -->
          <button
            type="button"
            class="relative block aspect-3/3 w-full cursor-pointer overflow-hidden bg-gray-50 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            aria-label={`Открыть сертификат: ${award.title}`}
            data-awards-certificate-trigger
            data-awards-certificate-src={award.image.src}
            data-awards-certificate-alt={award.title}
          >
            <Image
              src={award.image}
              alt={award.title}
              class="w-full h-full object-cover transition-transform duration-slow ease-out group-hover:scale-[1.04]"
              loading="lazy"
            />
            <!-- Тонкий оверлей -->
            <div class="absolute inset-0 bg-linear-to-t from-black/30 to-transparent pointer-events-none"></div>
            <!-- Бейдж места -->
            <div class="absolute bottom-3 left-3">
              <span class:list={['inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-wide text-white shadow-lg', award.accent]}>
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
                {award.rank}
              </span>
            </div>
          </button>

          <!-- Контент -->
          <div class="p-6">
            <h3 class="font-montserrat font-extrabold text-gray-900 text-lg mb-3 uppercase tracking-wide">{award.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">{award.description}</p>

            <!-- Результаты -->
            <div class="space-y-2">
              {award.results.map(r => (
                <div class="flex items-start gap-3">
                  <span class:list={['shrink-0 w-2 h-2 rounded-full mt-1.5', award.accent]}></span>
                  <p class="text-sm leading-snug">
                    <span class="font-bold text-gray-900">{r.place}</span>
                    <span class="text-gray-500"> — {r.geo}</span>
                  </p>
                </div>
              ))}
            </div>
            {'footnote' in award && award.footnote && (
              <p class="text-gray-400 text-xs leading-relaxed mt-4">{award.footnote}</p>
            )}
            {'partnerNote' in award && award.partnerNote && (
              <p class="text-gray-600 text-sm leading-relaxed mt-4 pt-4 border-t border-gray-100" set:html={award.partnerNote} />
            )}
          </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Лента сертификатов MAXX ROYAL / VOYAGE -->
    <div class="awards-card reveal-hidden mt-6 bg-white rounded-3xl overflow-hidden border border-gray-100 transition-[box-shadow,border-color] duration-slow ease-out">
      <div class="p-6 md:p-7">
        <div class="mb-5">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-wide text-white shadow-lg bg-primary">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            {maxxAward.ribbonRank}
          </div>
        </div>

        <div class="relative" data-awards-gallery-root="true">
          <div
            data-awards-gallery-shadow-left
            class="pointer-events-none absolute left-0 top-0 bottom-2 z-10 w-12 bg-linear-to-r from-white to-transparent opacity-0 transition-opacity duration-500 ease-out sm:hidden"
            aria-hidden="true"
          ></div>
          <div
            data-awards-gallery-shadow-right
            class="pointer-events-none absolute right-0 top-0 bottom-2 z-10 w-12 bg-linear-to-l from-white to-transparent opacity-0 transition-opacity duration-500 ease-out sm:hidden"
            aria-hidden="true"
          ></div>

          <div
            class="flex gap-4 overflow-x-auto scroll-smooth pb-2 -mx-6 px-6 sm:mx-0 sm:px-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            data-awards-gallery-track
          >
            {maxxAward.images.map((image, index) => (
              <div class="relative aspect-3/3 w-[78%] sm:w-[46%] lg:w-[30%] xl:w-[24%] shrink-0 overflow-hidden rounded-2xl bg-gray-50" data-awards-gallery-slide>
                <button
                  type="button"
                  class="group/certificate block h-full w-full cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                  aria-label={`Открыть сертификат: ${maxxAward.title} — сертификат ${index + 1}`}
                  data-awards-certificate-trigger
                  data-awards-certificate-src={image.src}
                  data-awards-certificate-alt={`${maxxAward.title} — сертификат ${index + 1}`}
                >
                  <Image
                    src={image}
                    alt={`${maxxAward.title} — сертификат ${index + 1}`}
                    width={800}
                    height={800}
                    sizes="(max-width: 639px) 78vw, (max-width: 1023px) 46vw, 30vw"
                    class="w-full h-full object-cover transition-transform duration-slow ease-out group-hover/certificate:scale-[1.03]"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
            ))}
          </div>

          <button
            type="button"
            class="hidden sm:flex absolute left-3 top-1/2 z-20 h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-sm transition-colors duration-fast hover:bg-black/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-white pointer-events-auto"
            aria-label="Предыдущий сертификат"
            data-awards-gallery-prev
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            class="hidden sm:flex absolute right-3 top-1/2 z-20 h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-sm transition-colors duration-fast hover:bg-black/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-white pointer-events-auto"
            aria-label="Следующий сертификат"
            data-awards-gallery-next
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

<div
  id="awards-certificate-modal"
  class="fixed inset-0 z-modal hidden items-center justify-center bg-black/60 px-4 opacity-0 backdrop-blur-sm max-md:backdrop-blur-none transition-opacity duration-slow max-md:duration-300 max-md:ease-[cubic-bezier(0.33,1,0.68,1)]"
  role="dialog"
  aria-modal="true"
  aria-label="Просмотр сертификата"
  tabindex="-1"
>
  <img
    id="awards-certificate-modal-image"
    class="max-h-[90dvh] max-w-[92vw] rounded-2xl object-contain translate-y-20 max-md:translate-y-8 transition-transform duration-slow ease-out max-md:duration-300 max-md:ease-[cubic-bezier(0.33,1,0.68,1)] [&.modal-open]:translate-y-0"
    alt=""
    decoding="async"
    loading="eager"
  />
</div>

<script>
  const awardsGalleryState = new WeakMap<HTMLElement, { currentIndex: number }>();
  const awardsCertificateTriggers = new WeakSet<HTMLElement>();
  const awardsCertificateImageCache = new Map<string, Promise<void>>();

  function getCertificateSrc(button: HTMLElement) {
    const thumb = button.querySelector('img');
    if (thumb instanceof HTMLImageElement && thumb.complete && thumb.naturalWidth > 0) {
      return thumb.currentSrc || thumb.src;
    }
    return button.dataset.awardsCertificateSrc || '';
  }

  function preloadCertificateImage(src: string) {
    if (!src) return Promise.resolve();

    const cached = awardsCertificateImageCache.get(src);
    if (cached) return cached;

    const image = new Image();
    image.decoding = 'async';
    image.src = src;
    const ready = image.decode().catch(() => undefined);
    awardsCertificateImageCache.set(src, ready);
    return ready;
  }

  function applyModalImageSource(button: HTMLElement, modalImage: HTMLImageElement) {
    const src = getCertificateSrc(button);

    if (!src) return;

    modalImage.removeAttribute('srcset');
    modalImage.removeAttribute('sizes');

    if (modalImage.src !== src) {
      modalImage.src = src;
    }
  }

  function getSlideScrollLeft(track: HTMLElement, slide: HTMLElement) {
    return slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
  }

  function initAwardsGalleries() {
    document.querySelectorAll('[data-awards-gallery-root]').forEach((root) => {
      const gallery = root as HTMLElement;
      const track = gallery.querySelector('[data-awards-gallery-track]') as HTMLElement | null;
      const prevButton = gallery.querySelector('[data-awards-gallery-prev]') as HTMLButtonElement | null;
      const nextButton = gallery.querySelector('[data-awards-gallery-next]') as HTMLButtonElement | null;
      const leftShadow = gallery.querySelector('[data-awards-gallery-shadow-left]') as HTMLElement | null;
      const rightShadow = gallery.querySelector('[data-awards-gallery-shadow-right]') as HTMLElement | null;
      const slides = Array.from(gallery.querySelectorAll('[data-awards-gallery-slide]')) as HTMLElement[];

      if (!track || !prevButton || !nextButton || slides.length < 2) return;
      if (awardsGalleryState.has(gallery)) return;

      const setShadowVisible = (shadow: HTMLElement | null, visible: boolean) => {
        shadow?.classList.toggle('opacity-0', !visible);
        shadow?.classList.toggle('opacity-100', visible);
      };

      const updateScrollShadows = () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const canScrollLeft = track.scrollLeft > 4;
        const canScrollRight = maxScroll > 4 && track.scrollLeft < maxScroll - 4;
        setShadowVisible(leftShadow, canScrollLeft);
        setShadowVisible(rightShadow, canScrollRight);
      };

      /** 8 шагов (индексы 0–7), на 8-м «вперёд» — возврат к началу */
      const lastStepIndex = Math.min(7, slides.length - 1);
      const state = { currentIndex: 0 };
      awardsGalleryState.set(gallery, state);

      const scrollToIndex = (index: number) => {
        const target = slides[index];
        if (!target) return;

        const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
        state.currentIndex = index;

        track.scrollTo({
          left: Math.min(getSlideScrollLeft(track, target), maxScrollLeft),
          behavior: 'smooth',
        });
      };

      prevButton.addEventListener('click', (event) => {
        event.preventDefault();
        scrollToIndex(state.currentIndex <= 0 ? lastStepIndex : state.currentIndex - 1);
      });

      nextButton.addEventListener('click', (event) => {
        event.preventDefault();
        scrollToIndex(state.currentIndex >= lastStepIndex ? 0 : state.currentIndex + 1);
      });

      track.addEventListener('scroll', updateScrollShadows, { passive: true });
      window.addEventListener('resize', updateScrollShadows);
      updateScrollShadows();
    });
  }

  function initAwardsCertificateModal() {
    const modal = document.getElementById('awards-certificate-modal') as HTMLElement | null;
    const modalImage = document.getElementById('awards-certificate-modal-image') as HTMLImageElement | null;

    if (!modal || !modalImage) return;
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    let previousFocus: Element | null = null;

    const closeModal = () => {
      if (modal.classList.contains('hidden')) return;

      modalImage.style.willChange = 'transform';
      modal.classList.add('opacity-0');
      modalImage.classList.remove('modal-open');

      const onCloseEnd = () => {
        if (!modal.classList.contains('opacity-0')) return;

        modalImage.style.willChange = '';
        modal.classList.add('hidden');
        modal.style.display = '';
        if (window.unlockScroll) window.unlockScroll();
        previousFocus instanceof HTMLElement && previousFocus.focus();
        previousFocus = null;
      };

      modalImage.addEventListener('transitionend', onCloseEnd, { once: true });
    };

    const openModal = (button: HTMLElement) => {
      const alt = button.dataset.awardsCertificateAlt || 'Сертификат ANRO TRIP';
      const src = getCertificateSrc(button) || button.dataset.awardsCertificateSrc || '';

      if (!src) return;

      previousFocus = document.activeElement;
      modalImage.alt = alt;
      applyModalImageSource(button, modalImage);
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      if (window.lockScroll) window.lockScroll();

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          modalImage.style.willChange = 'transform';
          modal.classList.remove('opacity-0');
          modalImage.classList.add('modal-open');
          modal.focus();
        });
      });
    };

    document.querySelectorAll('[data-awards-certificate-trigger]').forEach((trigger) => {
      const button = trigger as HTMLElement;
      if (awardsCertificateTriggers.has(button)) return;

      awardsCertificateTriggers.add(button);
      button.addEventListener('click', () => openModal(button));
      button.addEventListener('pointerenter', () => {
        preloadCertificateImage(getCertificateSrc(button) || button.dataset.awardsCertificateSrc || '');
      }, { passive: true });
      button.addEventListener('focus', () => {
        preloadCertificateImage(getCertificateSrc(button) || button.dataset.awardsCertificateSrc || '');
      });
    });

    if (modal.dataset.awardsCertificateReady === 'true') return;
    modal.dataset.awardsCertificateReady = 'true';

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    const preloadAllCertificateImages = () => {
      const uniqueSrcs = new Set<string>();
      document.querySelectorAll<HTMLElement>('[data-awards-certificate-trigger]').forEach((button) => {
        const src = getCertificateSrc(button) || button.dataset.awardsCertificateSrc || '';
        if (src) uniqueSrcs.add(src);
      });

      uniqueSrcs.forEach((src) => {
        preloadCertificateImage(src);
      });
    };

    const schedulePreload = window.requestIdleCallback
      ? (callback: () => void) => window.requestIdleCallback(callback, { timeout: 2500 })
      : (callback: () => void) => setTimeout(callback, 800);

    schedulePreload(preloadAllCertificateImages);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initAwardsGalleries();
    initAwardsCertificateModal();
  });
  document.addEventListener('astro:page-load', () => {
    initAwardsGalleries();
    initAwardsCertificateModal();
  });
</script>
