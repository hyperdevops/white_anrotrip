---
import BlogListPage from '../../../components/blog/BlogListPage.astro';
import { prepareBlogListViewModel } from '../../../lib/blog-list';
import { siteBlogIndex } from '../../../lib/site-urls';

const rawPage = Astro.params.page;
if (!rawPage || !/^[1-9]\d*$/.test(rawPage)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const pageNum = parseInt(rawPage, 10);
if (pageNum === 1) {
  return Astro.redirect(siteBlogIndex());
}

const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const viewModel = await prepareBlogListViewModel(pageNum, siteOrigin);

if (!viewModel) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<BlogListPage {...viewModel} />
