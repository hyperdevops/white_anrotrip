---
import '../styles/global.css';
import favicon from '../assets/favicon.png';
import { ClientRouter } from 'astro:transitions';
import ScrollProgress from '../components/ScrollProgress.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CallbackModal from '../components/CallbackModal.astro';
import ReviewModal from '../components/ReviewModal.astro';
import FavoritesWidget from '../components/FavoritesWidget.astro';
import CookieBanner from '../components/CookieBanner.astro';
import OfficeWidget from '../components/OfficeWidget.astro';
import GiftModal from '../components/GiftModal.astro';
import { siteHome } from '../lib/site-urls';

interface Props {
  title: string;
  description?: string;
  /** Полный URL страницы для canonical и og:url (если не задан — берётся из Astro.url) */
  canonicalURL?: string;
  /** Путь или URL картинки для превью в соцсетях (рекомендуется 1200×630). По умолчанию favicon из assets */
  ogImage?: string;
  showFavorites?: boolean;
  showScrollProgress?: boolean;
  showScrollToTop?: boolean;
  /** Позиция кнопки «Наверх» (только при showScrollToTop) */
  scrollToTopVariant?: 'default' | 'blog';
  showOfficeWidget?: boolean;
  /** Виджет офиса (карточка «Связаться» + мессенджеры) */
  officeWidgetVariant?: 'default' | 'corp';
  /** Показывать Schema.org JSON-LD (для страниц вроде cabinet/terms/privacy — false) */
  showSchema?: boolean;
}

const {
  title,
  description = 'ANRO TRIP — Путешествия, которые меняют жизнь.',
  canonicalURL,
  ogImage = '/og-image.jpg',
  showFavorites = true,
  showScrollProgress = true,
  showScrollToTop = true,
  scrollToTopVariant = 'default',
  showOfficeWidget = true,
  officeWidgetVariant = 'default',
  showSchema = true,
} = Astro.props;

const baseUrl = Astro.url.origin;
const base = siteHome();
const basePath = new URL(base, baseUrl).pathname.replace(/\/$/, '') || '/';
const canonical = canonicalURL ?? Astro.url.href;
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, baseUrl).href;

/** Стабильный id организации для связи филиалов (LocalBusiness) с TravelAgency */
const organizationId = `${baseUrl}/#organization`;
const parentOrganization = { '@id': organizationId };

/** JSON-LD TravelAgency — корневая сущность; url сайта, не canonical страницы */
const travelAgencySchema = {
  '@type': 'TravelAgency',
  '@id': organizationId,
  name: 'ANRO TRIP',
  description:
    'Туристическая компания. Более 18 лет организуем путешествия и командировки по всему миру.',
  url: baseUrl,
  logo: `${baseUrl}/og-image.jpg`,
  image: `${baseUrl}/og-image.jpg`,
  telephone: '+78002224473',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Екатеринбург',
    addressCountry: 'RU',
  },
  areaServed: {
    '@type': 'Place',
    name: 'Россия и мир',
  },
  sameAs: [
    'https://t.me/anro_trip',
    'https://max.ru/u/f9LHodD0cOKNXrTMtvUZWd2zLeGEpz34bQ0i1a-Ur_6EKrIw9H11bR6uhLM',
    'https://t.me/anrotrip',
    'https://vk.com/anrotrip',
    'https://max.ru/id6658540239_biz',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+78002224473',
    contactType: 'customer service',
    availableLanguage: 'Russian',
  },
};

/**
 * Офисы: адреса как в Contacts/Footer.
 * Екатеринбург — на сайте без улицы (представительство), в разметке только город и регион.
 */
const localBusinessEkaterinburg = {
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#localbusiness-ekaterinburg`,
  name: 'ANRO TRIP — Екатеринбург',
  description:
    'Представительство туристической компании ANRO TRIP в Екатеринбурге. Встреча по предварительной договорённости.',
  image: ogImageUrl,
  url: baseUrl,
  telephone: '+78002224473',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Екатеринбург',
    addressRegion: 'Свердловская область',
    addressCountry: 'RU',
  },
  parentOrganization,
};

const localBusinessChelyabinsk = {
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#localbusiness-chelyabinsk`,
  name: 'ANRO TRIP — Челябинск',
  description:
    'Офис туристической компании ANRO TRIP в Челябинске. Пн–пт 9:00–18:00, сб–вс по договорённости.',
  image: ogImageUrl,
  url: baseUrl,
  telephone: '+73512252991',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. 250-летия Челябинска, д. 29, пом. 2',
    addressLocality: 'Челябинск',
    postalCode: '454003',
    addressCountry: 'RU',
  },
  parentOrganization,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
};

/** Один блок JSON-LD: TravelAgency + филиалы */
const schemaOrgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    travelAgencySchema,
    localBusinessEkaterinburg,
    localBusinessChelyabinsk,
  ],
};
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00abb3" />
    <meta name="geo.region" content="RU-SVE" />

    {
      import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      import.meta.env.PUBLIC_YANDEX_VERIFICATION && (
        <meta
          name="yandex-verification"
          content={import.meta.env.PUBLIC_YANDEX_VERIFICATION}
        />
      )
    }

    <!-- Favicon (из assets — оптимизируется при сборке) -->
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={favicon.src} />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter / X Card (превью при шеринге; дублирует OG для совместимости с X и краулерами) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD -->
    {
      showSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schemaOrgGraph)}
        />
      )
    }

    <script is:inline define:vars={{ basePath }}>
      (function () {
        var currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        var normalizedBase = basePath.replace(/\/$/, '') || '/';
        var isHome =
          currentPath === normalizedBase ||
          currentPath === normalizedBase + '/index.html';

        var pendingHash = null;
        try {
          pendingHash = sessionStorage.getItem('pendingHomeHash');
        } catch (e) {
          pendingHash = null;
        }

        if (isHome && (window.location.hash || pendingHash)) {
          document.documentElement.classList.add('has-pending-home-anchor');
        }
      })();
    </script>

    <ClientRouter />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body
    class="bg-white text-gray-900 font-inter antialiased overflow-x-hidden selection:bg-primary/20 selection:text-primary-dark"
    data-base={base}
  >
    {
      /* Вспышка при загрузке — fade-in 0.5s, учитываем prefers-reduced-motion */
    }
    <script is:inline>
      (function () {
        var d = document;
        var prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        var sameOriginReferrer = false;
        try {
          sameOriginReferrer =
            !!document.referrer &&
            new URL(document.referrer).origin === window.location.origin;
        } catch (e) {
          sameOriginReferrer = false;
        }
        // Fade только при «холодном» заходе; при возврате с блога/других страниц сайта — без вспышки
        if (!prefersReduced && !sameOriginReferrer) {
          d.documentElement.style.opacity = '0';
          d.body.style.opacity = '0';
          d.documentElement.style.transition = 'opacity 0.5s ease';
          d.body.style.transition = 'opacity 0.5s ease';
        }
        function fadeIn() {
          if (prefersReduced || sameOriginReferrer) return;
          d.documentElement.style.opacity = '1';
          d.body.style.opacity = '1';
          setTimeout(function () {
            d.documentElement.style.transition = '';
            d.documentElement.style.opacity = '';
            d.body.style.transition = '';
            d.body.style.opacity = '';
          }, 500);
        }
        if (d.readyState === 'loading') {
          d.addEventListener('DOMContentLoaded', fadeIn);
        } else {
          fadeIn();
        }
      })();
    </script>
    {
      /* Единый плавный скролл: детерминированная анимация на requestAnimationFrame —
         одинаковая длительность и easing во ВСЕХ браузерах (нативный scroll-behavior:smooth
         крутит с разной скоростью в Firefox/Chrome). Используется хедером, кнопкой «Наверх»,
         Hero, PopularTours, corp, Team; делегированный фолбэк ловит прочие якорные ссылки. */
    }
    <script is:inline>
      (function () {
        function prefersReduced() {
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }
        function clampTop(top) {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          return Math.max(0, Math.min(top, max));
        }
        function easeInOutCubic(t) {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        window.smoothScrollTo = function (top, onDone) {
          var target = clampTop(top);
          var startY = window.scrollY;
          var dist = target - startY;
          if (prefersReduced() || Math.abs(dist) < 2) {
            window.scrollTo(0, target);
            if (onDone) onDone();
            return;
          }
          // Длительность зависит от дистанции, но в едином диапазоне (плавный, неспешный скролл)
          var duration = Math.min(1600, Math.max(750, Math.abs(dist) * 0.7));
          var startT = performance.now();
          function step(now) {
            var p = Math.min(1, (now - startT) / duration);
            window.scrollTo(0, Math.round(startY + dist * easeInOutCubic(p)));
            if (p < 1) requestAnimationFrame(step);
            else if (onDone) onDone();
          }
          requestAnimationFrame(step);
        };

        window.smoothScrollIntoView = function (el, onDone) {
          if (!el) return;
          var smt = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
          var top = el.getBoundingClientRect().top + window.scrollY - smt;
          window.smoothScrollTo(top, onDone);
        };

        // Фолбэк для прочих якорей (футер и т.п.); свои обработчики имеют приоритет
        // через e.defaultPrevented. window/document переживают View Transitions —
        // вешаем слушатель один раз.
        if (!window.__anchorSmoothInit) {
          window.__anchorSmoothInit = true;
          document.addEventListener('click', function (e) {
            if (
              e.defaultPrevented ||
              e.button !== 0 ||
              e.metaKey ||
              e.ctrlKey ||
              e.shiftKey ||
              e.altKey
            )
              return;
            var t = e.target;
            var a = t && t.closest ? t.closest('a[href^="#"]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (href.length < 2) return;
            var el = document.getElementById(href.slice(1));
            if (!el) return;
            e.preventDefault();
            window.smoothScrollIntoView(el);
          });
        }
      })();
    </script>
    {/* Skip Link: виден при фокусе (Tab), для клавиатуры и скринридеров */}
    <a
      href="#content"
      class="fixed left-4 top-0 z-9999 -translate-y-full rounded-b-md bg-primary px-4 py-2.5 text-sm font-semibold text-white focus:shadow-lg transition-transform duration-fast focus:translate-y-0 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      Перейти к содержимому
    </a>
    {showScrollProgress && <ScrollProgress />}
    <slot />
    {showScrollToTop && <ScrollToTop variant={scrollToTopVariant} />}
    {showFavorites && <FavoritesWidget />}
    {showOfficeWidget && <OfficeWidget variant={officeWidgetVariant} />}
    <CookieBanner />
    <GiftModal />
    <CallbackModal />
    <ReviewModal />

    {
      /* Tourvisor не поддерживает View Transition → полная перезагрузка при переходе на главную; при «Назад» из bfcache тоже перезагружаем */
    }
    <script is:inline>
      function scrollHomeToHash(hash, doc) {
        var root = doc || document;
        var view = root.defaultView || window;
        if (!hash || hash.length < 2) return false;

        var id = decodeURIComponent(hash.charAt(0) === '#' ? hash.slice(1) : hash);
        var anchor = root.getElementById(id);
        if (!anchor) return false;

        var headerEl = root.getElementById('site-header');
        var headerHeight = headerEl ? headerEl.offsetHeight : 64;
        var top;

        if (id !== 'search' && id !== 'content') {
          var badge = anchor.querySelector(
            '.section-badge, .inline-flex.rounded-full',
          );
          if (badge) {
            var layoutTop = 0;
            var node = badge;
            while (node) {
              layoutTop += node.offsetTop;
              node = node.offsetParent;
            }
            var extraGap = id === 'directions' ? 20 : 0;
            top = layoutTop - headerHeight - 26 - extraGap;
          }
        }

        if (top === undefined) {
          var isMobile = view.matchMedia('(max-width: 767px)').matches;
          var offset =
            id === 'search'
              ? isMobile
                ? headerHeight - 16
                : 78
              : headerHeight + 25;
          top =
            anchor.getBoundingClientRect().top + view.scrollY - offset;
        }

        view.scrollTo(0, Math.max(0, top));
        return true;
      }

      function revealHomeAfterAnchor() {
        document.documentElement.classList.add('is-home-anchor-ready');
        window.setTimeout(function () {
          document.documentElement.classList.remove(
            'has-pending-home-anchor',
            'is-home-anchor-ready',
          );
        }, 200);
      }

      window.scrollHomeToHash = scrollHomeToHash;
      window.revealHomeAfterAnchor = revealHomeAfterAnchor;

      function getHomeNavigation(url) {
        var base = document.body.dataset.base || '/';
        var basePath =
          new URL(base, window.location.origin).pathname.replace(/\/$/, '') ||
          '/';
        var targetPath = url.pathname.replace(/\/$/, '') || '/';
        var isHome =
          url.origin === window.location.origin &&
          (targetPath === basePath || targetPath === basePath + '/index.html');

        return { isHome: isHome, hash: url.hash || '' };
      }

      function runHomeAnchorScroll(doc) {
        var hash =
          (doc && doc.defaultView && doc.defaultView.location.hash) ||
          window.location.hash ||
          sessionStorage.getItem('pendingHomeHash') ||
          '';
        if (!hash) return false;

        var scrolled = scrollHomeToHash(hash, doc || undefined);
        if (scrolled && !doc) {
          sessionStorage.removeItem('pendingHomeHash');
        }
        return scrolled;
      }

      document.addEventListener('click', function (event) {
        var target = event.target;
        var link = target && target.closest ? target.closest('a[href]') : null;
        if (!link) return;

        try {
          var url = new URL(link.href);
          var homeNavigation = getHomeNavigation(url);

          if (homeNavigation.isHome && homeNavigation.hash) {
            sessionStorage.setItem('pendingHomeHash', homeNavigation.hash);
            document.documentElement.classList.add('has-pending-home-anchor');
          } else {
            sessionStorage.removeItem('pendingHomeHash');
          }
        } catch (e) {
          sessionStorage.removeItem('pendingHomeHash');
        }
      });

      document.addEventListener(
        'click',
        function (event) {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;

          var target = event.target;
          var link = target && target.closest ? target.closest('a[href]') : null;
          if (!link || !link.hasAttribute('data-astro-reload')) return;

          try {
            var url = new URL(link.href);
            var homeNavigation = getHomeNavigation(url);
            if (!homeNavigation.isHome) return;

            event.preventDefault();
            if (homeNavigation.hash) {
              sessionStorage.setItem('pendingHomeHash', homeNavigation.hash);
            } else {
              sessionStorage.removeItem('pendingHomeHash');
            }
            document.documentElement.classList.add('is-page-leaving');
            window.setTimeout(function () {
              window.location.href = url.href;
            }, 220);
          } catch (e) {
            return;
          }
        },
        true,
      );

      document.addEventListener('astro:before-swap', function (e) {
        var isMainPage = e.newDocument.getElementById('search-widget');
        if (!isMainPage) return;

        var hash = sessionStorage.getItem('pendingHomeHash') || '';
        if (hash) {
          e.newDocument.documentElement.classList.add('has-pending-home-anchor');
          runHomeAnchorScroll(e.newDocument);
          return;
        }

        if (
          e.newDocument.querySelector('.tv-search-form.tv-moduleid-192367')
        ) {
          e.swap = function () {
            var b = document.body.dataset.base || '/';
            sessionStorage.removeItem('pendingHomeHash');
            window.location.href = window.location.origin + b;
          };
        }
      });

      document.addEventListener('astro:after-swap', function () {
        if (!document.getElementById('search-widget')) return;

        var hash =
          window.location.hash || sessionStorage.getItem('pendingHomeHash') || '';
        if (!hash) return;

        document.documentElement.classList.add('has-pending-home-anchor');
        runHomeAnchorScroll();

        requestAnimationFrame(function () {
          runHomeAnchorScroll();
          revealHomeAfterAnchor();
        });
      });

      window.addEventListener('pageshow', function (e) {
        if (e.persisted && document.querySelector('#search-widget')) {
          window.location.reload();
        }
      });
    </script>
    <!-- Scroll reveal + scroll lock (модалки) -->
    <script is:inline>
      window.initScrollReveal = () => {
        if (window.__revealObserver) {
          window.__revealObserver.disconnect();
        }

        const prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            root: null,
            rootMargin: '0px 0px -4% 0px',
            threshold: 0.01,
          },
        );

        window.__revealObserver = observer;

        const viewportH =
          window.innerHeight || document.documentElement.clientHeight;

        document.querySelectorAll('.reveal-hidden').forEach((el) => {
          if (prefersReduced) {
            el.classList.add('reveal-visible');
            return;
          }

          const rect = el.getBoundingClientRect();
          const inView = rect.top < viewportH * 0.96 && rect.bottom > 0;

          if (inView) {
            el.classList.add('reveal-visible');
            return;
          }

          el.classList.remove('reveal-visible');
          observer.observe(el);
        });
      };

      window.initScrollReveal();

      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.add('is-route-swapping');
      });

      document.addEventListener('astro:page-load', () => {
        document.documentElement.classList.remove('is-route-swapping');
        requestAnimationFrame(() => {
          window.initScrollReveal?.();
          window.initSearchWidget?.();
          window.initNemoWidget?.();
        });
      });

      function getScrollbarWidth() {
        return window.innerWidth - document.documentElement.clientWidth;
      }

      window.lockScroll = () => {
        const scrollbarWidth = getScrollbarWidth();

        if (scrollbarWidth <= 0) {
          document.body.style.overflow = 'hidden';
          return;
        }

        document.body.style.paddingRight = `${scrollbarWidth}px`;

        const header = document.querySelector('header');
        if (header) {
          header.style.paddingRight = `${scrollbarWidth}px`;
        }

        document.body.style.overflow = 'hidden';
      };

      window.unlockScroll = () => {
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';

        const header = document.querySelector('header');
        if (header) {
          header.style.paddingRight = '';
        }
      };
    </script>
  </body>
</html>
