---
import '../styles/global.css';
import favicon from '../assets/favicon.png';
import { ClientRouter } from 'astro:transitions';
import ScrollProgress from '../components/ScrollProgress.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CallbackModal from '../components/CallbackModal.astro';
import ReviewModal from '../components/ReviewModal.astro';
import FavoritesWidget from '../components/FavoritesWidget.astro';
import CookieBanner from '../components/CookieBanner.astro';
import OfficeWidget from '../components/OfficeWidget.astro';
import GiftModal from '../components/GiftModal.astro';
import { siteHome } from '../lib/site-urls';

interface Props {
  title: string;
  description?: string;
  /** Полный URL страницы для canonical и og:url (если не задан — берётся из Astro.url) */
  canonicalURL?: string;
  /** Путь или URL картинки для превью в соцсетях (рекомендуется 1200×630). По умолчанию favicon из assets */
  ogImage?: string;
  showFavorites?: boolean;
  showScrollProgress?: boolean;
  showScrollToTop?: boolean;
  /** Позиция кнопки «Наверх» (только при showScrollToTop) */
  scrollToTopVariant?: 'default' | 'blog';
  showOfficeWidget?: boolean;
  /** Виджет офиса (карточка «Связаться» + мессенджеры) */
  officeWidgetVariant?: 'default' | 'corp';
  /** Показывать Schema.org JSON-LD (для страниц вроде cabinet/terms/privacy — false) */
  showSchema?: boolean;
}

const {
  title,
  description = 'ANRO TRIP — Путешествия, которые меняют жизнь.',
  canonicalURL,
  ogImage = '/og-image.jpg',
  showFavorites = true,
  showScrollProgress = true,
  showScrollToTop = true,
  scrollToTopVariant = 'default',
  showOfficeWidget = true,
  officeWidgetVariant = 'default',
  showSchema = true,
} = Astro.props;

const baseUrl = Astro.url.origin;
const base = siteHome();
const canonical = canonicalURL ?? Astro.url.href;
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, baseUrl).href;

/** Стабильный id организации для связи филиалов (LocalBusiness) с TravelAgency */
const organizationId = `${baseUrl}/#organization`;
const parentOrganization = { '@id': organizationId };

/** JSON-LD TravelAgency — корневая сущность; url сайта, не canonical страницы */
const travelAgencySchema = {
  '@type': 'TravelAgency',
  '@id': organizationId,
  name: 'ANRO TRIP',
  description:
    'Туристическая компания. Более 18 лет организуем путешествия и командировки по всему миру.',
  url: baseUrl,
  logo: `${baseUrl}/og-image.jpg`,
  image: `${baseUrl}/og-image.jpg`,
  telephone: '+78002224473',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Екатеринбург',
    addressCountry: 'RU',
  },
  areaServed: {
    '@type': 'Place',
    name: 'Россия и мир',
  },
  sameAs: [
    'https://t.me/anro_trip',
    'https://max.ru/u/f9LHodD0cOKNXrTMtvUZWd2zLeGEpz34bQ0i1a-Ur_6EKrIw9H11bR6uhLM',
    'https://t.me/anrotrip',
    'https://vk.com/anrotrip',
    'https://max.ru/id6658540239_biz',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+78002224473',
    contactType: 'customer service',
    availableLanguage: 'Russian',
  },
};

/**
 * Офисы: адреса как в Contacts/Footer.
 * Екатеринбург — на сайте без улицы (представительство), в разметке только город и регион.
 */
const localBusinessEkaterinburg = {
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#localbusiness-ekaterinburg`,
  name: 'ANRO TRIP — Екатеринбург',
  description:
    'Представительство туристической компании ANRO TRIP в Екатеринбурге. Встреча по предварительной договорённости.',
  image: ogImageUrl,
  url: baseUrl,
  telephone: '+78002224473',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Екатеринбург',
    addressRegion: 'Свердловская область',
    addressCountry: 'RU',
  },
  parentOrganization,
};

const localBusinessChelyabinsk = {
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#localbusiness-chelyabinsk`,
  name: 'ANRO TRIP — Челябинск',
  description:
    'Офис туристической компании ANRO TRIP в Челябинске. Пн–пт 9:00–18:00, сб–вс по договорённости.',
  image: ogImageUrl,
  url: baseUrl,
  telephone: '+73512252991',
  priceRange: '₽₽',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. 250-летия Челябинска, д. 29, пом. 2',
    addressLocality: 'Челябинск',
    postalCode: '454003',
    addressCountry: 'RU',
  },
  parentOrganization,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
};

/** Один блок JSON-LD: TravelAgency + филиалы */
const schemaOrgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    travelAgencySchema,
    localBusinessEkaterinburg,
    localBusinessChelyabinsk,
  ],
};
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00abb3" />

    <!-- Favicon (из assets — оптимизируется при сборке) -->
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={favicon.src} />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter / X Card (превью при шеринге; дублирует OG для совместимости с X и краулерами) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD -->
    {
      showSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schemaOrgGraph)}
        />
      )
    }

    <ClientRouter />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body
    class="bg-white text-gray-900 font-inter antialiased overflow-x-hidden selection:bg-primary/20 selection:text-primary-dark"
    data-base={base}
  >
    {
      /* Вспышка при загрузке — fade-in 0.5s, учитываем prefers-reduced-motion */
    }
    <script is:inline>
      (function () {
        var d = document;
        var prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        if (!prefersReduced) {
          d.documentElement.style.opacity = '0';
          d.body.style.opacity = '0';
          d.documentElement.style.transition = 'opacity 0.5s ease';
          d.body.style.transition = 'opacity 0.5s ease';
        }
        function fadeIn() {
          if (prefersReduced) return;
          d.documentElement.style.opacity = '1';
          d.body.style.opacity = '1';
          setTimeout(function () {
            d.documentElement.style.transition = '';
            d.documentElement.style.opacity = '';
            d.body.style.transition = '';
            d.body.style.opacity = '';
          }, 500);
        }
        if (d.readyState === 'loading') {
          d.addEventListener('DOMContentLoaded', fadeIn);
        } else {
          fadeIn();
        }
      })();
    </script>
    {/* Skip Link: виден при фокусе (Tab), для клавиатуры и скринридеров */}
    <a
      href="#content"
      class="fixed left-4 top-0 z-9999 -translate-y-full rounded-b-md bg-primary px-4 py-2.5 text-sm font-semibold text-white focus:shadow-lg transition-transform duration-fast focus:translate-y-0 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      Перейти к содержимому
    </a>
    {showScrollProgress && <ScrollProgress />}
    <slot />
    {showScrollToTop && <ScrollToTop variant={scrollToTopVariant} />}
    {showFavorites && <FavoritesWidget />}
    {showOfficeWidget && <OfficeWidget variant={officeWidgetVariant} />}
    <CookieBanner />
    <GiftModal />
    <CallbackModal />
    <ReviewModal />

    {
      /* Tourvisor не поддерживает View Transition → полная перезагрузка при переходе на главную; при «Назад» из bfcache тоже перезагружаем */
    }
    <script is:inline>
      document.addEventListener('astro:before-swap', function (e) {
        var isMainPage = e.newDocument.querySelector(
          '.tv-search-form.tv-moduleid-192367',
        );
        if (isMainPage) {
          e.swap = function () {
            var b = document.body.dataset.base || '/';
            window.location.href = window.location.origin + b;
          };
        }
      });
      window.addEventListener('pageshow', function (e) {
        if (e.persisted && document.querySelector('#search-widget')) {
          window.location.reload();
        }
      });
    </script>
    <!-- Scroll reveal + scroll lock (модалки) -->
    <script is:inline>
      window.initScrollReveal = () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1,
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-hidden').forEach((el) => {
          observer.observe(el);
        });
      };

      window.initScrollReveal();

      document.addEventListener('astro:page-load', () => {
        requestAnimationFrame(() => {
          window.initScrollReveal?.();
          window.initSearchWidget?.();
          window.initNemoWidget?.();
          window.initTourvisorWidget?.();
        });
      });

      function getScrollbarWidth() {
        return window.innerWidth - document.documentElement.clientWidth;
      }

      window.lockScroll = () => {
        const scrollbarWidth = getScrollbarWidth();

        if (scrollbarWidth <= 0) {
          document.body.style.overflow = 'hidden';
          return;
        }

        document.body.style.paddingRight = `${scrollbarWidth}px`;

        const header = document.querySelector('header');
        if (header) {
          header.style.paddingRight = `${scrollbarWidth}px`;
        }

        document.body.style.overflow = 'hidden';
      };

      window.unlockScroll = () => {
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';

        const header = document.querySelector('header');
        if (header) {
          header.style.paddingRight = '';
        }
      };
    </script>
  </body>
</html>
